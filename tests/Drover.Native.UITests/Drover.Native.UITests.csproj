<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The harness for the native screen checks. It runs the real server in process with a scripted model, starts a
       build of the app made for the checks (App/, compiled into that build only), and reads its report. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="App/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Drover.Server\Drover.Server.csproj" />
    <ProjectReference Include="..\Drover.Adapters.Conformance\Drover.Adapters.Conformance.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\PostgresServer.cs" Link="Shared\PostgresServer.cs" />
    <Compile Include="..\Shared\TestRolePasswords.cs" Link="Shared\TestRolePasswords.cs" />
    <Compile Include="..\Shared\PostgresAttempt.cs" Link="Shared\PostgresAttempt.cs" />
    <Compile Include="..\Shared\PostgresLocator.cs" Link="Shared\PostgresLocator.cs" />
    <Compile Include="..\Shared\TestEnvironmentException.cs" Link="Shared\TestEnvironmentException.cs" />
    <Compile Include="..\Shared\ScriptedModelProvider.cs" Link="Shared\ScriptedModelProvider.cs" />
    <Compile Include="..\Shared\PointerEvents.cs" Link="Shared\PointerEvents.cs" />
    <Compile Include="..\Drover.Server.Tests\Support\MemorySandboxProvider.cs" Link="Shared\MemorySandboxProvider.cs" />
  </ItemGroup>

</Project>
