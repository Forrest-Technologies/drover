<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- The fake server builds its client through the client factory, as every client in Drover does. The browser
       tests serve the client's shared web files from a small server of their own. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Drover.Presentation\Drover.Presentation.csproj" />
  </ItemGroup>

  <!-- The native service registration is compiled in so its share inbox lifetime is checked here, without a device.
       The platform-only pieces it asks for are stood in for by Shell/AppServicesStubs.cs. -->
  <ItemGroup>
    <Compile Include="..\..\src\Drover.Native\Shell\AppServices.cs" Link="Shell\AppServices.cs" />
  </ItemGroup>

  <!-- The device checks' guard, report, and automation names, read by the rules that hold them in step with the app. -->
  <ItemGroup>
    <Compile Include="..\..\src\Drover.Native\Platforms\Desktop\UpdatePackageTrust.cs" Link="Platform\UpdatePackageTrust.cs" />
    <Compile Include="..\..\src\Drover.Native\Platforms\Desktop\UpdateInstall.cs" Link="Platform\UpdateInstall.cs" />
    <Compile Include="..\..\src\Drover.Native\Platforms\Desktop\UpdateDownloads.cs" Link="Platform\UpdateDownloads.cs" />
    <Compile Include="..\..\src\Drover.Native\Platforms\Desktop\UpdateCheckFlow.cs" Link="Platform\UpdateCheckFlow.cs" />
    <Compile Include="..\Drover.Native.UITests\AndroidCheckGuard.cs" Link="Rules\AndroidCheckGuard.cs" />
    <Compile Include="..\Drover.Native.UITests\IosCheckReport.cs" Link="Rules\IosCheckReport.cs" />
    <Compile Include="..\Drover.Native.UITests\App\AutomationIds.cs" Link="Rules\AutomationIds.cs" />
  </ItemGroup>

  <!-- Event logs recorded from a real server. -->
  <ItemGroup>
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
