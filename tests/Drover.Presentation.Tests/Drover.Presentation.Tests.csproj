<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- The fake server builds its client through the client factory, as every client in Drover does. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Drover.Presentation\Drover.Presentation.csproj" />
  </ItemGroup>

  <!-- The stand-ins and the contrast arithmetic are the ones the web client's tests use: one source, two suites. -->
  <ItemGroup>
    <Compile Include="..\..\src\Drover.Native\Platforms\Desktop\UpdatePackageTrust.cs" Link="Platform\UpdatePackageTrust.cs" />
    <Compile Include="..\..\src\Drover.Native\Platforms\Desktop\UpdateInstall.cs" Link="Platform\UpdateInstall.cs" />
    <Compile Include="..\Drover.Ui.Tests\Support\FakeServer.cs" Link="Support\FakeServer.cs" />
    <Compile Include="..\Drover.Ui.Tests\Support\LiveEvents.cs" Link="Support\LiveEvents.cs" />
    <Compile Include="..\Drover.Ui.Tests\Support\FakeServerChoice.cs" Link="Support\FakeServerChoice.cs" />
    <Compile Include="..\Drover.Ui.Tests\Rules\Contrast.cs" Link="Rules\Contrast.cs" />
    <!-- What a conversation is made of, and what is read out of it, is tested once and runs in both suites. -->
    <Compile Include="..\Drover.Ui.Tests\Chat\ConversationsTests.cs" Link="ViewModels\Chat\ConversationsTests.cs" />
    <Compile Include="..\Drover.Ui.Tests\Chat\SentenceAnnouncerTests.cs" Link="ViewModels\Chat\SentenceAnnouncerTests.cs" />
  </ItemGroup>

  <!-- The event logs recorded from a real server are the ones the web client's tests read: linked, not copied. -->
  <ItemGroup>
    <None Include="..\Drover.Ui.Tests\Fixtures\*.json" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
