<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the desktop app's credential store against the real one of the computer it runs on: the Keychain on
       macOS, the Secret Service on Linux, DPAPI on Windows. It needs that store, so it is not in Drover.slnx, whose
       Linux CI has none. The desktop workflow runs it on each system, on Linux under a test Secret Service
       (scripts/check-native-desktop.sh). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/Drover.Native/Platforms/Desktop/DesktopSecrets.cs" Link="Desktop/DesktopSecrets.cs" />
    <Compile Include="../../src/Drover.Native/Platforms/Desktop/SystemSecrets.cs" Link="Desktop/SystemSecrets.cs" />
  </ItemGroup>

</Project>
