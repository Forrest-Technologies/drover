<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.drover.tests.keyboard">
  <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="35" />
  <application android:label="Drover test keyboard">
    <service android:name=".TestKeyboard" android:exported="true"
             android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter>
        <action android:name="android.view.InputMethod" />
      </intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/keyboard" />
    </service>
  </application>
</manifest>
