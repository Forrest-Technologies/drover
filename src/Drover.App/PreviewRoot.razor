@using Drover.Ui
@using Drover.Ui.Components
@using Drover.Ui.Layouts
@using Microsoft.AspNetCore.Components.Web
@inject ServerAddress Server
@inject AppRequests Requests
@inject ILogger<PreviewRoot> Logger
@inject NavigationManager Navigation
@inject NotificationNavigation Notification
@implements IDisposable

@if (Server.Current is not null)
{
    <DroverApp />
}
else
{
    <PageTitle>Connect to Drover</PageTitle>
    <EntryLayout>
        <Body>
            <h1>Connect to Drover</h1>
            <p class="dv-entry-lead">Enter the HTTPS address of your Drover server.</p>
            <form class="dv-entry-form" @onsubmit="Connect" @onsubmit:preventDefault>
                <Field Label="Server address" Type="url" @bind-Value="address"
                       Placeholder="https://drover.example.org" required="true" Disabled="busy" />
                <StatusNote Kind="NoteKind.Danger" Text="@problem" />
                <Button Kind="ButtonKind.Primary" Type="submit" Disabled="busy">
                    @(busy ? "Connecting" : "Connect")
                </Button>
            </form>
        </Body>
    </EntryLayout>
}

@code {
    #region Private Fields

    private string address = string.Empty;

    private string? problem;

    private bool busy;

    #endregion

    #region Interface Implementations

    public void Dispose() => Notification.Changed -= QueueNotificationNavigation;

    #endregion

    #region Private Methods

    protected override void OnInitialized() => Notification.Changed += QueueNotificationNavigation;

    protected override void OnAfterRender(bool firstRender) => OpenNotificationConversation();

    private void QueueNotificationNavigation() => _ = InvokeAsync(OpenNotificationConversation);

    private void OpenNotificationConversation()
    {
        if (Server.Current is not null && Notification.Take() is { } address)
        {
            Navigation.NavigateTo(address);
        }
    }

    private async Task Connect()
    {
        if (ServerAddress.Parse(address) is not { } origin)
        {
            problem = "Enter an HTTPS address without a path.";
            return;
        }

        busy = true;
        problem = null;
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(15));
        try
        {
            if (await Requests.IsDroverServer(origin, timeout.Token))
            {
                Server.Set(origin);
            }
            else
            {
                problem = "That address did not respond as a Drover server.";
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException)
        {
            Logger.LogWarning(exception, "Could not connect to the Drover server");
            problem = "Could not reach Drover. Check the address and try again.";
        }
        finally
        {
            busy = false;
        }
    }

    #endregion
}
