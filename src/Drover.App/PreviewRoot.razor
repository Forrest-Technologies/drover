@using Drover.Ui.Components
@using Drover.Ui.Layouts
@using Microsoft.AspNetCore.Components.Web
@inject ServerAddress Server

@if (Server.Current is not null)
{
    <DroverApp />
}
else
{
    <PageTitle>Connect to Drover</PageTitle>
    <EntryLayout>
        <Body>
            <h1>Connect to Drover</h1>
            <p class="dv-entry-lead">Enter the HTTPS address of your Drover server.</p>
            <form class="dv-entry-form" @onsubmit="Connect" @onsubmit:preventDefault>
                <Field Label="Server address" Type="url" @bind-Value="address"
                       Placeholder="https://drover.example.org" required="true" />
                <StatusNote Kind="NoteKind.Danger" Text="@problem" />
                <Button Kind="ButtonKind.Primary" Type="submit">Continue to sign in</Button>
            </form>
        </Body>
    </EntryLayout>
}

@code {
    #region Private Fields

    private string address = string.Empty;

    private string? problem;

    #endregion

    #region Private Methods

    private void Connect()
    {
        problem = Server.Set(address) ? null : "Enter an HTTPS address without a path, such as https://drover.example.org.";
    }

    #endregion
}
