<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- The design package needs Roslyn 5.0.0 while the analyzers stay on 4.14.0 so they load in older compilers.
         Central pinning would force 4.14.0 here, so this project names the version its design package needs. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read by analyzer DRV0006 and by the isolation suite. -->
    <AdditionalFiles Include="GlobalTables.manifest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Drover.Domain\Drover.Domain.csproj" />
  </ItemGroup>
</Project>
