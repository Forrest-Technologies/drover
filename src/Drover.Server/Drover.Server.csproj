<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The server serves no JS modules. In Debug, SDK 11.0.100 still makes a hot reload script here and hands it
       to the Web SDK test projects that reference the server, whose Debug build then fails (#916). Remove once
       global.json moves to an SDK with the fix (#917). -->
  <PropertyGroup>
    <JSModulesEnabled>false</JSModulesEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Drover.Engine\Drover.Engine.csproj" />
    <ProjectReference Include="..\Drover.Agents\Drover.Agents.csproj" />
    <ProjectReference Include="..\Drover.Adapters.OpenAICompatible\Drover.Adapters.OpenAICompatible.csproj" />
    <ProjectReference Include="..\Drover.Adapters.Gemini\Drover.Adapters.Gemini.csproj" />
    <ProjectReference Include="..\Drover.Adapters.Venice\Drover.Adapters.Venice.csproj" />
    <ProjectReference Include="..\Drover.Adapters.Mcp\Drover.Adapters.Mcp.csproj" />
    <ProjectReference Include="..\Drover.Adapters.LocalFiles\Drover.Adapters.LocalFiles.csproj" />
    <ProjectReference Include="..\Drover.Adapters.DataProtection\Drover.Adapters.DataProtection.csproj" />
    <ProjectReference Include="..\Drover.Adapters.E2B\Drover.Adapters.E2B.csproj" />
    <ProjectReference Include="..\Drover.Adapters.WebPush\Drover.Adapters.WebPush.csproj" />
    <ProjectReference Include="..\Drover.Adapters.SearXng\Drover.Adapters.SearXng.csproj" />
  </ItemGroup>

  <!-- What the browser client's former address, /native/, still answers (Clients/RetiredNativeAddress.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="Clients/retired-native-*" LogicalName="Drover.Server.Clients.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
