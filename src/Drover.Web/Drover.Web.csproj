<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Drover.Ui\Drover.Ui.csproj" />
  </ItemGroup>

  <!-- The antiforgery handler is shared with the native client's browser build. -->
  <ItemGroup>
    <Compile Include="..\Shared\Transport\AntiforgeryHandler.cs" Link="Transport\AntiforgeryHandler.cs" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
