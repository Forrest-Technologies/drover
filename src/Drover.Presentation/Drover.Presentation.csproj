<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything about the interface that is not tied to a UI framework: words, drafts, layouts as data, and the
       view models. The native client builds on it. The files moved here from the retired web client keep the
       Drover.Ui namespaces they were written in, so no caller changed when they moved. -->
  <PropertyGroup>
    <RootNamespace>Drover.Ui</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Drover.Presentation.Tests" />
    <InternalsVisibleTo Include="Drover.Native" />
  </ItemGroup>

  <!-- Night Yard is the one theme that ships through the pipeline so far. The other theme files in the same folder
       are the designs of issue 421: each is embedded when the issue that ships it lands. -->
  <ItemGroup>
    <EmbeddedResource Include="Theme\Themes\night-yard.json" LogicalName="Drover.Themes.night-yard.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Drover.Client\Drover.Client.csproj" />
    <ProjectReference Include="..\Drover.Contracts\Drover.Contracts.csproj" />
  </ItemGroup>

</Project>
