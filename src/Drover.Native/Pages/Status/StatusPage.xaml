<shell:Screen x:Class="Drover.Native.Pages.StatusPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:dv="using:Drover.Native.Controls"
              xmlns:layouts="using:Drover.Native.Layouts"
              xmlns:local="using:Drover.Native.Pages"
              xmlns:shell="using:Drover.Native.Shell"
              xmlns:ui="using:Drover.Ui"
              xmlns:vm="using:Drover.Presentation.ViewModels">

  <shell:Screen.Resources>
    <!-- One row of the report, as a template for the server's rows and the space's: the name and the word that says
         its state, what it means, and when it was checked. -->
    <DataTemplate x:Key="StatusRowTemplate" x:DataType="vm:StatusEntry">
      <local:RuleBox>
        <StackPanel Spacing="{StaticResource DvSpace1}">
          <local:SpreadPanel Gap="{StaticResource DvSpace3}" RowGap="{StaticResource DvSpace2}" Align="Center">
            <TextBlock Style="{StaticResource DvTextLabel}"
                       Foreground="{ThemeResource DvTextBrush}"
                       FontSize="{StaticResource DvText14}"
                       LineHeight="{StaticResource DvLine14}"
                       local:SpreadPanel.Grows="True"
                       Text="{x:Bind Name}" />
            <dv:Badge Kind="{x:Bind Kind}" Text="{x:Bind Word}" />
          </local:SpreadPanel>
          <TextBlock Style="{StaticResource DvTextSecondary}" Text="{x:Bind Summary}" />
          <TextBlock Style="{StaticResource DvTextMono}"
                     FontSize="{StaticResource DvText13}"
                     LineHeight="{StaticResource DvLine13}"
                     Text="{x:Bind Checked}"
                     Visibility="{x:Bind HasChecked}" />
        </StackPanel>
      </local:RuleBox>
    </DataTemplate>
  </shell:Screen.Resources>

  <layouts:WorkLayout>
    <local:SpreadPanel Gap="{StaticResource DvSpace3}" RowGap="{StaticResource DvSpace3}" Align="Center">
      <TextBlock Style="{StaticResource DvTextH2}" AutomationProperties.HeadingLevel="Level1" Text="{x:Bind vm:StatusViewModel.Heading}" />
      <dv:Button Content="Check again"
                 Command="{x:Bind Model.LoadCommand}"
                 IsEnabled="{x:Bind Model.CanCheckAgain, Mode=OneWay}"
                 Visibility="{x:Bind Model.ShowCheckAgain, Mode=OneWay}" />
    </local:SpreadPanel>

    <TextBlock Style="{StaticResource DvTextSecondary}"
               Text="{x:Bind vm:StatusViewModel.RestrictedNote}"
               Visibility="{x:Bind Model.ShowRestricted, Mode=OneWay}" />

    <dv:EmptyState x:Name="LoadFailed"
                   x:Load="{x:Bind Model.ShowFailed, Mode=OneWay}"
                   Title="{x:Bind vm:StatusViewModel.FailedTitle}"
                   Cause="{x:Bind Model.LoadProblem, Mode=OneWay}"
                   ActionLabel="Try again"
                   ActionCommand="{x:Bind Model.LoadCommand}" />

    <TextBlock Style="{StaticResource DvTextSecondary}"
               AutomationProperties.LiveSetting="Polite"
               Text="{x:Bind vm:StatusViewModel.CheckingNote}"
               Visibility="{x:Bind Model.ShowChecking, Mode=OneWay}" />

    <StackPanel Spacing="{StaticResource DvSpace5}" Visibility="{x:Bind Model.ShowReport, Mode=OneWay}">
      <StackPanel Spacing="{StaticResource DvSpace3}" Visibility="{x:Bind Model.ShowServer, Mode=OneWay}">
        <TextBlock Style="{StaticResource DvTextH3}" AutomationProperties.HeadingLevel="Level2" Text="{x:Bind vm:StatusViewModel.ServerHeading}" />
        <ItemsControl ItemsSource="{x:Bind Model.ServerRows, Mode=OneWay}"
                      ItemTemplate="{StaticResource StatusRowTemplate}"
                      AutomationProperties.Name="{x:Bind vm:StatusViewModel.ServerHeading}"
                      IsTabStop="False" />
      </StackPanel>

      <StackPanel Spacing="{StaticResource DvSpace3}">
        <TextBlock Style="{StaticResource DvTextH3}" AutomationProperties.HeadingLevel="Level2" Text="{x:Bind vm:StatusViewModel.SpaceHeading}" />
        <dv:FlowPanel Gap="{StaticResource DvSpace1}" Visibility="{x:Bind Model.ShowNoSpaceRows, Mode=OneWay}">
          <TextBlock Style="{StaticResource DvTextSecondary}" Text="{x:Bind vm:StatusViewModel.NoSpaceRowsBefore}" />
          <dv:Link Text="{x:Bind vm:StatusViewModel.AddModelLabel}" Address="{x:Bind ui:Addresses.SetupModel}" />
          <TextBlock Style="{StaticResource DvTextSecondary}" Text="or" />
          <dv:Link Text="{x:Bind vm:StatusViewModel.AddToolLabel}" Address="{x:Bind ui:Addresses.Tools}" />
          <TextBlock Style="{StaticResource DvTextSecondary}" Text="{x:Bind vm:StatusViewModel.NoSpaceRowsAfter}" />
        </dv:FlowPanel>
        <ItemsControl ItemsSource="{x:Bind Model.SpaceRows, Mode=OneWay}"
                      ItemTemplate="{StaticResource StatusRowTemplate}"
                      AutomationProperties.Name="{x:Bind vm:StatusViewModel.SpaceHeading}"
                      IsTabStop="False"
                      Visibility="{x:Bind Model.ShowSpaceRows, Mode=OneWay}" />
      </StackPanel>
    </StackPanel>
  </layouts:WorkLayout>

</shell:Screen>
