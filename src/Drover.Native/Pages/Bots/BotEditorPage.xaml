<shell:Screen x:Class="Drover.Native.Pages.BotEditorPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:layouts="using:Drover.Native.Layouts"
              xmlns:shell="using:Drover.Native.Shell">

  <!-- Who the bot is at the top, then one closed frame for each thing it can be given. The parts are built in code
       from the view model, since which of them show depends on the bot and on what the server allows. -->
  <layouts:WorkLayout x:Name="Layout">
    <ContentControl x:Name="Stage" HorizontalContentAlignment="Stretch" IsTabStop="False" />
    <TextBlock x:Name="Loading" Style="{StaticResource DvTextParagraph}" Foreground="{ThemeResource DvText2Brush}" FontSize="{StaticResource DvText13}" AutomationProperties.LiveSetting="Polite" />
    <Grid x:Name="Form" />
  </layouts:WorkLayout>

</shell:Screen>
