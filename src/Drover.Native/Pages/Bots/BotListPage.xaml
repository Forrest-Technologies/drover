<shell:Screen x:Class="Drover.Native.Pages.BotListPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:dv="using:Drover.Native.Controls"
              xmlns:layouts="using:Drover.Native.Layouts"
              xmlns:pages="using:Drover.Native.Pages"
              xmlns:shell="using:Drover.Native.Shell">

  <layouts:WorkLayout>
    <Grid ColumnSpacing="{StaticResource DvSpace3}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Heading" Style="{StaticResource DvTextH2}" AutomationProperties.HeadingLevel="Level1" VerticalAlignment="Center" />
      <dv:Button x:Name="NewBot" Grid.Column="1" Kind="Primary" VerticalAlignment="Center" Click="MakeBot" />
    </Grid>

    <dv:StatusNote Kind="Danger" Text="{x:Bind Model.Problem, Mode=OneWay}" />

    <!-- The empty, failed, and missing-model states are made when the list is in them: each needs its words to exist. -->
    <ContentControl x:Name="Stage" HorizontalContentAlignment="Stretch" IsTabStop="False" />
    <TextBlock x:Name="Loading" Style="{StaticResource DvTextParagraph}" Foreground="{ThemeResource DvText2Brush}" AutomationProperties.LiveSetting="Polite" />
    <TextBlock x:Name="NoBotForMember" Style="{StaticResource DvTextParagraph}" Foreground="{ThemeResource DvText2Brush}" />
    <TextBlock x:Name="MemberHint" Style="{StaticResource DvTextParagraph}" Foreground="{ThemeResource DvText2Brush}" />
    <pages:NamedGroup x:Name="Crew" Spacing="{StaticResource DvSpace3}" Role="List" />
  </layouts:WorkLayout>

</shell:Screen>
