<shell:Screen x:Class="Drover.Native.Pages.UsagePage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:dv="using:Drover.Native.Controls"
              xmlns:layouts="using:Drover.Native.Layouts"
              xmlns:local="using:Drover.Native.Pages"
              xmlns:shell="using:Drover.Native.Shell"
              xmlns:vm="using:Drover.Presentation.ViewModels">

  <layouts:WorkLayout>
    <local:SpreadPanel Gap="{StaticResource DvSpace3}" RowGap="{StaticResource DvSpace3}" Align="Center">
      <TextBlock Style="{StaticResource DvTextH2}" AutomationProperties.HeadingLevel="Level1" Text="{x:Bind vm:UsageViewModel.Heading}" />
      <dv:SegmentedControl x:Name="Period"
                           Label="{x:Bind vm:UsageViewModel.PeriodLabel}"
                           Options="{x:Bind vm:UsageViewModel.Periods}"
                           Value="{x:Bind Model.Period, Mode=TwoWay}" />
    </local:SpreadPanel>

    <TextBlock Style="{StaticResource DvTextSecondary}"
               Text="{x:Bind vm:UsageViewModel.OwnRunsHint}"
               Visibility="{x:Bind Model.ShowOwnRunsHint, Mode=OneWay}" />

    <dv:EmptyState x:Name="LoadFailed"
                   x:Load="{x:Bind Model.ShowFailed, Mode=OneWay}"
                   Title="{x:Bind vm:UsageViewModel.FailedTitle}"
                   Cause="{x:Bind Model.LoadProblem, Mode=OneWay}"
                   ActionLabel="Try again"
                   ActionCommand="{x:Bind Model.LoadCommand}" />

    <TextBlock Style="{StaticResource DvTextSecondary}"
               AutomationProperties.LiveSetting="Polite"
               Text="{x:Bind vm:UsageViewModel.LoadingNote}"
               Visibility="{x:Bind Model.ShowLoading, Mode=OneWay}" />

    <StackPanel Spacing="{StaticResource DvSpace5}" Visibility="{x:Bind Model.ShowCrew, Mode=OneWay}">
      <local:UsageTable x:Name="Table" Table="{x:Bind Model.Table, Mode=OneWay}" BotChosen="ChooseBot" />

      <StackPanel Spacing="{StaticResource DvSpace3}" Visibility="{x:Bind Model.ShowRuns, Mode=OneWay}">
        <ContentControl x:Name="RunsHeading" IsTabStop="False" HorizontalContentAlignment="Left">
          <TextBlock Style="{StaticResource DvTextH3}" AutomationProperties.HeadingLevel="Level2" Text="{x:Bind Model.RunsTitle, Mode=OneWay}" />
        </ContentControl>

        <dv:EmptyState x:Name="RunsFailed"
                       x:Load="{x:Bind Model.ShowRunsFailed, Mode=OneWay}"
                       Title="{x:Bind vm:UsageViewModel.RunsFailedTitle}"
                       Cause="{x:Bind Model.RunsProblem, Mode=OneWay}"
                       ActionLabel="Try again"
                       ActionCommand="{x:Bind Model.LoadRunsCommand}" />

        <TextBlock Style="{StaticResource DvTextSecondary}"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{x:Bind vm:UsageViewModel.RunsLoadingNote}"
                   Visibility="{x:Bind Model.ShowRunsLoading, Mode=OneWay}" />

        <TextBlock Style="{StaticResource DvTextSecondary}"
                   Text="{x:Bind Model.NoRunsNote, Mode=OneWay}"
                   Visibility="{x:Bind Model.ShowNoRuns, Mode=OneWay}" />

        <ItemsControl ItemsSource="{x:Bind Model.RunLines, Mode=OneWay}"
                      IsTabStop="False"
                      Visibility="{x:Bind Model.ShowRunsList, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UsageRunLine">
              <local:RuleBox Space="DvSpace2">
                <dv:FlowPanel Gap="{StaticResource DvSpace3}">
                  <TextBlock Style="{StaticResource DvTextLabel}"
                             Foreground="{ThemeResource DvTextBrush}"
                             TextWrapping="NoWrap"
                             Text="{x:Bind Cost}" />
                  <dv:Link Ink="DvText" HoverInk="DvText" Text="{x:Bind Place}" Address="{x:Bind Address}" />
                  <TextBlock Style="{StaticResource DvTextMono}"
                             Foreground="{ThemeResource DvText2Brush}"
                             Text="{x:Bind Tokens}" />
                  <TextBlock Style="{StaticResource DvTextLabel}"
                             FontWeight="{StaticResource DvWeightBody}"
                             dv:FlowPanel.FullRow="True"
                             Text="{x:Bind LeftOut}"
                             Visibility="{x:Bind HasLeftOut}" />
                </dv:FlowPanel>
              </local:RuleBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource DvTextSecondary}"
                   Text="{x:Bind Model.UnopenedNote, Mode=OneWay}"
                   Visibility="{x:Bind Model.ShowUnopened, Mode=OneWay}" />
      </StackPanel>
    </StackPanel>
  </layouts:WorkLayout>

</shell:Screen>
