<shell:Screen x:Class="Drover.Native.Pages.ExtensionsPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:dv="using:Drover.Native.Controls"
              xmlns:layouts="using:Drover.Native.Layouts"
              xmlns:pages="using:Drover.Native.Pages"
              xmlns:shell="using:Drover.Native.Shell"
              xmlns:vm="using:Drover.Presentation.ViewModels">

  <layouts:WorkLayout x:Name="Layout">
    <dv:ScreenHeader Title="{x:Bind vm:ExtensionsViewModel.Title}">
      <dv:IconButton x:Name="ImportExtension"
                     Icon="Plus"
                     Label="{x:Bind vm:ExtensionsViewModel.ImportAction}"
                     AutomationProperties.AutomationId="ImportExtension" />
    </dv:ScreenHeader>

    <dv:StatusNote Kind="{x:Bind Model.NoticeKind, Mode=OneWay}" Text="{x:Bind Model.Notice, Mode=OneWay}" />

    <ContentControl x:Name="Under" IsTabStop="False" HorizontalContentAlignment="Stretch" />
  </layouts:WorkLayout>

</shell:Screen>
