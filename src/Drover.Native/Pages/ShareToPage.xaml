<shell:Screen x:Class="Drover.Native.Pages.ShareToPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:dv="using:Drover.Native.Controls"
              xmlns:layouts="using:Drover.Native.Layouts"
              xmlns:local="using:Drover.Native.Pages"
              xmlns:shell="using:Drover.Native.Shell"
              xmlns:ui="using:Drover.Ui"
              xmlns:vm="using:Drover.Presentation.ViewModels">

  <layouts:WorkLayout>
    <StackPanel x:Name="Column"
                Spacing="{StaticResource DvSpace4}"
                MaxWidth="{StaticResource DvEntryWidth}"
                HorizontalAlignment="Center">
      <TextBlock Style="{StaticResource DvTextH1}" AutomationProperties.HeadingLevel="Level1" Text="{x:Bind vm:ShareToViewModel.Heading}" />

      <dv:EmptyState Cause="{x:Bind vm:ShareToViewModel.NothingCause}"
                     ActionLabel="{x:Bind vm:ShareToViewModel.GoToCrewLabel}"
                     ActionHref="{x:Bind ui:Addresses.Home}"
                     Visibility="{x:Bind Model.ShowNothing, Mode=OneWay}" />

      <StackPanel Spacing="{StaticResource DvSpace4}" Visibility="{x:Bind Model.ShowShared, Mode=OneWay}">
        <local:ConnectionFrame AutomationProperties.Name="{x:Bind vm:ShareToViewModel.WhatYouSharedLabel}">
          <TextBlock Style="{StaticResource DvTextBody}"
                     MaxWidth="{StaticResource DvMeasure}"
                     IsTextSelectionEnabled="True"
                     Text="{x:Bind Model.Excerpt, Mode=OneWay}"
                     Visibility="{x:Bind Model.HasText, Mode=OneWay}" />
          <ItemsControl ItemsSource="{x:Bind Model.Files, Mode=OneWay}"
                        IsTabStop="False"
                        Visibility="{x:Bind Model.HasFiles, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="{StaticResource DvSpace2}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShareFile">
                <dv:FlowPanel Gap="{StaticResource DvSpace1}">
                  <TextBlock Style="{StaticResource DvTextBody}" Text="{x:Bind Name}" />
                  <TextBlock Style="{StaticResource DvTextMono}" Text="{x:Bind local:ShareToPage.SizeOf(Size)}" />
                </dv:FlowPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </local:ConnectionFrame>

        <dv:EmptyState x:Name="LoadFailed"
                       x:Load="{x:Bind Model.ShowFailed, Mode=OneWay}"
                       Title="{x:Bind vm:ShareToViewModel.FailedTitle}"
                       Cause="{x:Bind Model.Problem, Mode=OneWay}"
                       ActionLabel="Try again"
                       ActionCommand="{x:Bind Model.LoadCommand}" />

        <TextBlock Style="{StaticResource DvTextSecondary}"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{x:Bind vm:ShareToViewModel.LoadingNote}"
                   Visibility="{x:Bind Model.ShowLoading, Mode=OneWay}" />

        <dv:EmptyState Cause="{x:Bind vm:ShareToViewModel.NoBotsCause}"
                       ActionLabel="{x:Bind vm:ShareToViewModel.GoToCrewLabel}"
                       ActionHref="{x:Bind ui:Addresses.Home}"
                       Visibility="{x:Bind Model.ShowNoBots, Mode=OneWay}" />

        <StackPanel Spacing="{StaticResource DvSpace4}" Visibility="{x:Bind Model.ShowBots, Mode=OneWay}">
          <TextBlock Style="{StaticResource DvTextH2}" Text="{x:Bind vm:ShareToViewModel.Ask}" />
          <TextBlock Style="{StaticResource DvTextSecondary}" Text="{x:Bind vm:ShareToViewModel.Note}" />
          <ItemsControl ItemsSource="{x:Bind Model.Choices, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind vm:ShareToViewModel.Ask}"
                        IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="{StaticResource DvSpace2}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShareBotChoice">
                <local:BotChoiceButton Command="{x:Bind ChooseCommand}" AutomationProperties.Name="{x:Bind Name}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource DvSpace3}">
                    <dv:Avatar Size="32" BotName="{x:Bind Name}" Hue="{x:Bind Hue}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Style="{StaticResource DvTextBody}" VerticalAlignment="Center" Text="{x:Bind Name}" />
                  </StackPanel>
                </local:BotChoiceButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <dv:Button HorizontalAlignment="Left" Content="{x:Bind vm:ShareToViewModel.DiscardLabel}" Command="{x:Bind Model.DiscardCommand}" />
      </StackPanel>
    </StackPanel>
  </layouts:WorkLayout>

</shell:Screen>
