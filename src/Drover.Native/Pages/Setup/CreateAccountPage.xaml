<shell:Screen x:Class="Drover.Native.Pages.CreateAccountPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:dv="using:Drover.Native.Controls"
              xmlns:layouts="using:Drover.Native.Layouts"
              xmlns:session="using:Drover.Native.Session"
              xmlns:shell="using:Drover.Native.Shell">
  <layouts:EntryLayout>
    <dv:SetupSteps Current="1" />
    <TextBlock Style="{StaticResource DvTextH2}" AutomationProperties.HeadingLevel="Level1" Text="Create your account" />
    <StackPanel x:Name="Checking" Spacing="{StaticResource DvSpace4}">
      <TextBlock x:Name="CheckingText" Style="{StaticResource DvTextSecondary}" AutomationProperties.LiveSetting="Polite" Text="Checking this server." />
      <dv:Button x:Name="Retry" Content="Try again" Command="{x:Bind Model.CheckServerCommand}" />
    </StackPanel>
    <StackPanel x:Name="Form" Spacing="{StaticResource DvSpace4}">
      <TextBlock Style="{StaticResource DvTextSecondary}" Text="This is the first account on this server. It owns the server and everything on it." />
      <dv:Field Label="Your name" Value="{x:Bind Model.DisplayName, Mode=TwoWay}" Disabled="{x:Bind Model.Busy, Mode=OneWay}" Submitted="Submit" />
      <dv:Field Label="Email" Type="email" Value="{x:Bind Model.Email, Mode=TwoWay}" Disabled="{x:Bind Model.Busy, Mode=OneWay}" Submitted="Submit" />
      <dv:Field Label="Password" Type="password" Value="{x:Bind Model.Password, Mode=TwoWay}" Hint="At least 12 characters." Disabled="{x:Bind Model.Busy, Mode=OneWay}" Submitted="Submit" />
      <dv:Field x:Name="Code" Label="Setup code" Value="{x:Bind Model.SetupCode, Mode=TwoWay}" Hint="Drover printed this code in its server log when it started. It proves you run this server." Disabled="{x:Bind Model.Busy, Mode=OneWay}" Submitted="Submit" />
      <dv:Button Kind="Primary" x:Name="Create" HorizontalAlignment="Stretch" Content="Create account" Command="{x:Bind Model.SubmitCommand}" />
    </StackPanel>
    <dv:StatusNote Kind="Danger" Text="{x:Bind Model.Problem, Mode=OneWay}" />
  </layouts:EntryLayout>
</shell:Screen>
