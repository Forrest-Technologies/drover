<shell:Screen x:Class="Drover.Native.Pages.CreateAccountPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:dv="using:Drover.Native.Controls"
              xmlns:layouts="using:Drover.Native.Layouts"
              xmlns:shell="using:Drover.Native.Shell"
              xmlns:vm="using:Drover.Presentation.ViewModels">

  <layouts:EntryLayout>
    <dv:SetupSteps Current="1" />
    <TextBlock Style="{StaticResource DvTextH2}" AutomationProperties.HeadingLevel="Level1" Text="{x:Bind vm:CreateAccountViewModel.Heading}" />

    <TextBlock Style="{StaticResource DvTextSecondary}"
               AutomationProperties.LiveSetting="Polite"
               Text="{x:Bind vm:CreateAccountViewModel.CheckingNote}"
               Visibility="{x:Bind Model.ShowChecking, Mode=OneWay}" />

    <StackPanel Spacing="{StaticResource DvSpace4}" Visibility="{x:Bind Model.ShowFailed, Mode=OneWay}">
      <dv:StatusNote Kind="Danger" Text="{x:Bind Model.Problem, Mode=OneWay}" />
      <dv:Button Kind="Primary" HorizontalAlignment="Left" Content="Try again" Command="{x:Bind Model.CheckServerCommand}" />
    </StackPanel>

    <StackPanel Spacing="{StaticResource DvSpace4}" Visibility="{x:Bind Model.ShowForm, Mode=OneWay}">
      <TextBlock Style="{StaticResource DvTextSecondary}" Text="{x:Bind vm:CreateAccountViewModel.Lead}" />
      <dv:Field Label="Your name"
                Value="{x:Bind Model.DisplayName, Mode=TwoWay}"
                Disabled="{x:Bind Model.Busy, Mode=OneWay}"
                Submitted="Submit" />
      <dv:Field Label="Email"
                Type="email"
                Value="{x:Bind Model.Email, Mode=TwoWay}"
                Disabled="{x:Bind Model.Busy, Mode=OneWay}"
                Submitted="Submit" />
      <dv:Field Label="Password"
                Type="password"
                Hint="{x:Bind vm:CreateAccountViewModel.PasswordHint}"
                Value="{x:Bind Model.Password, Mode=TwoWay}"
                Disabled="{x:Bind Model.Busy, Mode=OneWay}"
                Submitted="Submit" />
      <dv:Field Label="Setup code"
                Hint="{x:Bind vm:CreateAccountViewModel.SetupCodeHint}"
                Value="{x:Bind Model.SetupCode, Mode=TwoWay}"
                Disabled="{x:Bind Model.Busy, Mode=OneWay}"
                Visibility="{x:Bind Model.RequiresCode, Mode=OneWay}"
                Submitted="Submit" />
      <dv:StatusNote Kind="Danger" Text="{x:Bind Model.Problem, Mode=OneWay}" />
      <dv:Button Kind="Primary"
                 HorizontalAlignment="Left"
                 Content="{x:Bind Model.SubmitLabel, Mode=OneWay}"
                 Command="{x:Bind Model.SubmitCommand}" />
    </StackPanel>
  </layouts:EntryLayout>

</shell:Screen>
