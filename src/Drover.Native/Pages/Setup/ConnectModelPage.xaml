<shell:Screen x:Class="Drover.Native.Pages.ConnectModelPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:dv="using:Drover.Native.Controls"
              xmlns:layouts="using:Drover.Native.Layouts"
              xmlns:session="using:Drover.Native.Session"
              xmlns:shell="using:Drover.Native.Shell">
  <session:SessionGate>
    <layouts:EntryLayout>
      <dv:SetupSteps Current="2" />
      <TextBlock Style="{StaticResource DvTextH2}" AutomationProperties.HeadingLevel="Level1" Text="Connect a model" />
      <TextBlock Style="{StaticResource DvTextSecondary}" Text="Connect the model your bots use. The key is stored encrypted on this server and is never shown again." />
      <dv:SegmentedControl x:Name="Provider" Label="Provider" Fills="True" Value="{x:Bind Model.Kind, Mode=TwoWay}" Disabled="{x:Bind Model.Busy, Mode=OneWay}" />
      <dv:Field x:Name="Address" Label="Base address" Type="url" Value="{x:Bind Model.BaseUrl, Mode=TwoWay}" Placeholder="https://" Hint="Any server that speaks the chat completions API, such as one on your own machine." Disabled="{x:Bind Model.Busy, Mode=OneWay}" />
      <dv:Field x:Name="Key" Label="Key" Type="password" Value="{x:Bind Model.ApiKey, Mode=TwoWay}" Disabled="{x:Bind Model.Busy, Mode=OneWay}" Submitted="Submit" />
      <dv:StatusNote x:Name="Outcome" Text="{x:Bind Model.Outcome, Mode=OneWay}" />
      <TextBlock x:Name="Testing" Style="{StaticResource DvTextSecondary}" AutomationProperties.LiveSetting="Polite" Text="Asking the provider. This can take a few seconds." />
      <Grid x:Name="Actions">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <dv:Button x:Name="Test" HorizontalAlignment="Stretch" Content="Test connection" Command="{x:Bind Model.TestCommand}" />
        <dv:Button x:Name="Continue" Grid.Column="1" HorizontalAlignment="Stretch" Kind="Primary" Content="Continue" Command="{x:Bind Model.ContinueCommand}" />
      </Grid>
    </layouts:EntryLayout>
  </session:SessionGate>
</shell:Screen>
