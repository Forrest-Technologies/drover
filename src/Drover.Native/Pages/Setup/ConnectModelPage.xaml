<shell:Screen x:Class="Drover.Native.Pages.ConnectModelPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:dv="using:Drover.Native.Controls"
              xmlns:layouts="using:Drover.Native.Layouts"
              xmlns:session="using:Drover.Native.Session"
              xmlns:shell="using:Drover.Native.Shell">
  <session:SessionGate>
    <layouts:EntryLayout>
      <dv:SetupSteps Current="2" />
      <TextBlock Style="{StaticResource DvTextH2}" AutomationProperties.HeadingLevel="Level1" Text="Connect a model" />
      <TextBlock Style="{StaticResource DvTextSecondary}" Text="Connect the model your bots use. The key is stored encrypted on this server and is never shown again." />
      <TextBlock x:Name="ProvidersLoading" Style="{StaticResource DvTextSecondary}" AutomationProperties.LiveSetting="Polite" />
      <dv:EmptyState x:Name="ProvidersFailed" ActionCommand="{x:Bind Model.RetryProvidersCommand}" />
      <StackPanel x:Name="Form" Spacing="{StaticResource DvSpace3}">
      <TextBlock x:Name="OnlyKind" Style="{StaticResource DvTextSecondary}" />
      <dv:SegmentedControl x:Name="ProviderSegments" Label="Provider" Fills="True" Disabled="{x:Bind Model.Busy, Mode=OneWay}" />
      <dv:Select x:Name="Provider" Label="Provider" Disabled="{x:Bind Model.Busy, Mode=OneWay}" />
      <TextBlock x:Name="Reach" Style="{StaticResource DvTextSecondary}" />
      <dv:Field x:Name="Address" Label="Base address" Type="url" Value="{x:Bind Model.BaseUrl, Mode=TwoWay}" Placeholder="https://" Disabled="{x:Bind Model.Busy, Mode=OneWay}" />
      <dv:Button x:Name="ChangeAddress" HorizontalAlignment="Left" Command="{x:Bind Model.ChangeAddressCommand}" />
      <dv:Field x:Name="Key" Label="Key" Type="password" Value="{x:Bind Model.ApiKey, Mode=TwoWay}" Disabled="{x:Bind Model.Busy, Mode=OneWay}" Submitted="Submit" />
      <dv:Link x:Name="KeyLink" />
      <StackPanel x:Name="SignInPanel" Spacing="{StaticResource DvSpace3}">
        <TextBlock x:Name="PlanLine" Style="{StaticResource DvTextSecondary}" TextWrapping="Wrap" />
        <ContentControl x:Name="SignInNoteHolder" IsTabStop="False" HorizontalContentAlignment="Stretch">
          <dv:StatusNote x:Name="SignInNote" />
        </ContentControl>
        <dv:Button x:Name="SignInAction" HorizontalAlignment="Stretch" Click="ActOnSignIn" />
      </StackPanel>
      <dv:StatusNote x:Name="Outcome" Text="{x:Bind Model.Outcome, Mode=OneWay}" />
      <TextBlock x:Name="Testing" Style="{StaticResource DvTextSecondary}" AutomationProperties.LiveSetting="Polite" Text="Asking the provider. This can take a few seconds." />
      <Grid x:Name="Actions">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <dv:Button x:Name="Test" HorizontalAlignment="Stretch" Kind="Quiet" Content="Test connection" Command="{x:Bind Model.TestCommand}" />
        <dv:Button x:Name="Continue" Grid.Column="1" HorizontalAlignment="Stretch" Kind="Primary" Content="Continue" Command="{x:Bind Model.ContinueCommand}" />
      </Grid>
      </StackPanel>
    </layouts:EntryLayout>
  </session:SessionGate>
</shell:Screen>
