<shell:Screen x:Class="Drover.Native.Pages.MeetBotPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:contracts="using:Drover.Contracts"
              xmlns:dv="using:Drover.Native.Controls"
              xmlns:layouts="using:Drover.Native.Layouts"
              xmlns:session="using:Drover.Native.Session"
              xmlns:shell="using:Drover.Native.Shell">
  <session:SessionGate>
    <layouts:EntryLayout>
      <dv:SetupSteps Current="3" />
      <TextBlock Style="{StaticResource DvTextH2}" AutomationProperties.HeadingLevel="Level1" Text="Meet your first bot" />
      <ContentControl x:Name="State" />
      <StackPanel x:Name="Form" Spacing="{StaticResource DvSpace4}">
        <TextBlock Style="{StaticResource DvTextSecondary}" Text="Your first bot leads the crew. You talk to it, and the bots it makes for you work beneath it. Name it and choose the model it thinks with." />
        <dv:Field Label="Name" MaxLength="{x:Bind contracts:FieldLimits.BotName}" Value="{x:Bind Model.Name, Mode=TwoWay}" Disabled="{x:Bind Model.Busy, Mode=OneWay}" />
        <dv:Select x:Name="Models" Label="Model" Value="{x:Bind Model.Model, Mode=TwoWay}" Disabled="{x:Bind Model.Busy, Mode=OneWay}" />
        <dv:Field x:Name="ModelName" Label="Model name" MaxLength="{x:Bind contracts:FieldLimits.ModelName}" Value="{x:Bind Model.Model, Mode=TwoWay}" Disabled="{x:Bind Model.Busy, Mode=OneWay}" Submitted="Submit" />
        <dv:StatusNote Kind="Danger" Text="{x:Bind Model.Problem, Mode=OneWay}" />
        <dv:Button x:Name="Create" Kind="Primary" HorizontalAlignment="Stretch" Content="Create bot" Command="{x:Bind Model.CreateCommand}" />
      </StackPanel>
    </layouts:EntryLayout>
  </session:SessionGate>
</shell:Screen>
