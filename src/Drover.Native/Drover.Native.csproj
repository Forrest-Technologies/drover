<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <!-- Directory.Build.props names one framework for every project. This project has several, so the single
         name is cleared and the list below takes its place. -->
    <TargetFramework />
    <TargetFrameworks>net11.0-desktop;net11.0-browserwasm;net11.0-android</TargetFrameworks>
    <!-- macOS uses the desktop head. Uno 7 no longer supports a Mac Catalyst head. -->
    <TargetFrameworks Condition="'$(DroverEnableApple)' == 'true'">$(TargetFrameworks);net11.0-ios</TargetFrameworks>
    <!-- Build a single head on a machine with only that head's workloads. Unlike a global TargetFrameworks
         override, this does not change the frameworks of the ordinary libraries this project references. -->
    <TargetFrameworks Condition="'$(DroverNativeTargetFrameworks)' != ''">$(DroverNativeTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>Drover.Native</RootNamespace>

    <ApplicationTitle>Drover</ApplicationTitle>
    <ApplicationId>com.forresttechnologies.drover.client</ApplicationId>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <!-- The development server's targets switch the version attribute off in Debug so hot reload sees a stable
         assembly. CA1016 asks for one, so it stays on. -->
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
    <ApplicationPublisher>Drover</ApplicationPublisher>
    <Description>Drover, a self-hosted platform for running your own crew of bots.</Description>

    <!-- Only the open source parts of the platform. The design tools and the app inspection server are
         development-time products with their own terms, so neither is referenced, in any configuration. -->
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>

    <!-- Skia draws every target. It is implied, and named so SkiaSharp is referenced for the controls that draw
         with it (the icons, the bot characters). -->
    <UnoFeatures>Skia</UnoFeatures>

    <!-- The API contracts are read and written as JSON by reflection, as the web client does, so a published app
         keeps those assemblies whole (Platforms/WebAssembly/LinkerConfig.xml and the roots below). The trimmer's
         warnings about that reflection are the same ones the web client's SDK switches off by default. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <!-- Every Drover client formats the same way everywhere, so globalization stays invariant. The platform
         still asks for the device's culture by name at startup; this lets it have one, with invariant data. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>

    <!-- Dark until a person chooses otherwise, from the first frame. -->
    <UnoSplashScreenBackgroundColor>#05070A</UnoSplashScreenBackgroundColor>
  </PropertyGroup>

  <!-- The component gallery is part of a development build. This switch puts it in a release build too, for the
       parity bench: a published app is what runs under the server's security headers. -->
  <PropertyGroup Condition="'$(DroverShowGallery)' == 'true'">
    <DefineConstants>$(DefineConstants);DROVER_GALLERY</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browserwasm'">
    <!-- A published browser build is served by Drover's own server beside the web client, under this path. A
         development build is served from the root by the development host. -->
    <WasmShellWebAppBasePath Condition="'$(Configuration)' == 'Release'">/native/</WasmShellWebAppBasePath>

    <!-- The calls into the browser are generated by the platform's own interop generator, which writes unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- How requests reach the server. In a browser: the same-origin handler the web client uses. On a device: the
       handler and session the Android shell uses. Each is one source, compiled into both apps. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browserwasm'">
    <Compile Remove="Device/**" />
    <!-- Loaded by the page before the app starts. It keeps the platform's runtime within the content security policy. -->
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/NoEval.js" />
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Files.js" />
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Accessibility.js" />
    <Compile Include="../Shared/Transport/AntiforgeryHandler.cs" Link="Transport/AntiforgeryHandler.cs" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'browserwasm'">
    <Compile Include="../Shared/Transport/AppRequests.cs" Link="Transport/AppRequests.cs" />
    <Compile Include="../Shared/Transport/NativeSession.cs" Link="Transport/NativeSession.cs" />
    <Compile Include="../Shared/Transport/NativeSessionTokens.cs" Link="Transport/NativeSessionTokens.cs" />
    <Compile Include="../Shared/Transport/ServerAddress.cs" Link="Transport/ServerAddress.cs" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Drover.Contracts" />
    <TrimmerRootAssembly Include="Drover.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Drover.Client\Drover.Client.csproj" />
    <ProjectReference Include="..\Drover.Contracts\Drover.Contracts.csproj" />
    <ProjectReference Include="..\Drover.Presentation\Drover.Presentation.csproj" />
  </ItemGroup>

  <!-- The SDK adds two packages to every app that are not open source: its packaging helper, under an end-user
       agreement that forbids passing it on, and its account settings tool, which states no license. Neither is
       needed to build, run, or publish Drover, and Drover's license rule admits neither, so both are taken out
       of the package list before it is read. -->
  <Target Name="DropPackagesThatAreNotOpenSource" AfterTargets="UnoImplicitPackages">
    <ItemGroup>
      <PackageReference Remove="Uno.Sdk.Extras" />
      <PackageReference Remove="Uno.Settings.DevServer" />
    </ItemGroup>
  </Target>

</Project>
