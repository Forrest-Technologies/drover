<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <!-- Directory.Build.props names one framework for every project. This project has several, so the single
         name is cleared and the list below takes its place. -->
    <TargetFramework />
    <TargetFrameworks>net11.0-desktop;net11.0-browserwasm;net11.0-android</TargetFrameworks>
    <!-- macOS uses the desktop head. Uno 7 no longer supports a Mac Catalyst head. -->
    <TargetFrameworks Condition="'$(DroverEnableApple)' == 'true'">$(TargetFrameworks);net11.0-ios</TargetFrameworks>
    <!-- Build a single head on a machine with only that head's workloads. Unlike a global TargetFrameworks
         override, this does not change the frameworks of the ordinary libraries this project references. -->
    <TargetFrameworks Condition="'$(DroverNativeTargetFrameworks)' != ''">$(DroverNativeTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>Drover.Native</RootNamespace>

    <ApplicationTitle>Drover</ApplicationTitle>
    <ApplicationId>com.forresttechnologies.drover.client</ApplicationId>
    <!-- The checks build installs beside the regular app, so clearing it cannot erase a signed-in copy. -->
    <ApplicationId Condition="'$(DroverUiChecks)' == 'true'">com.forresttechnologies.drover.checks</ApplicationId>
    <!-- The offline deep-link check replaces the chosen server and then exits. A shipping build leaves it out. -->
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <!-- The development server's targets switch the version attribute off in Debug so hot reload sees a stable
         assembly. CA1016 asks for one, so it stays on. -->
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
    <ApplicationPublisher>Drover</ApplicationPublisher>
    <Description>Drover, a self-hosted platform for running your own crew of bots.</Description>

    <!-- Only the open source parts of the platform. The design tools and the app inspection server are
         development-time products with their own terms, so neither is referenced, in any configuration. -->
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>

    <!-- Skia draws every target. It is implied, and named so SkiaSharp is referenced for the controls that draw
         with it (the icons, the bot characters). -->
    <UnoFeatures>Skia</UnoFeatures>

    <!-- The API contracts are read and written as JSON by reflection, as the web client does, so a published app
         keeps those assemblies whole (Platforms/WebAssembly/LinkerConfig.xml and the roots below). The trimmer's
         warnings about that reflection are the same ones the web client's SDK switches off by default. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <!-- Every Drover client formats the same way everywhere, so globalization stays invariant. The platform
         still asks for the device's culture by name at startup; this lets it have one, with invariant data. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>

    <!-- Dark until a person chooses otherwise, from the first frame. -->
    <UnoSplashScreenBackgroundColor>#05070A</UnoSplashScreenBackgroundColor>
  </PropertyGroup>

  <!-- The component gallery is part of a development build. This switch puts it in a release build too, for the
       parity bench: a published app is what runs under the server's security headers. -->
  <PropertyGroup Condition="'$(DroverShowGallery)' == 'true'">
    <DefineConstants>$(DefineConstants);DROVER_GALLERY</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DroverTimelineFocusCheck)' == 'true'">
    <DefineConstants>$(DefineConstants);DROVER_TIMELINE_FOCUS_CHECK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(DroverTimelineFocusCheck)' != 'true'">
    <Compile Remove="Controls/TimelineFocusCheck.cs" />
  </ItemGroup>

  <!-- The operating system's credential store on a desktop (Keychain, Secret Service, or a file only the Windows
       user can decrypt), through Microsoft's maintained wrapper of the three. Used only by
       Platforms/Desktop/SystemSecrets.cs. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'desktop'">
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <Using Include="Microsoft.Identity.Client.Extensions.Msal" />
    <Using Include="System.Security.Cryptography" />
    <Using Include="System.Text" />
    <Using Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <!-- Keep cookies in the handler's own container. The secure session is restored through the device store. -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'desktop'">
    <Using Include="System.Net.Sockets" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="Uno.UI.Composition.Drawing" />
    <Using Include="Uno.UI.Composition.Skia" />
    <Using Include="Windows.UI.Text" />
    <EmbeddedResource Include="Assets/Fonts/Inter-Regular.ttf" LogicalName="Drover.Native.FallbackInter.ttf" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browserwasm'">
    <!-- A published browser build is served by Drover's own server beside the web client, under this path. A
         development build is served from the root by the development host. -->
    <WasmShellWebAppBasePath Condition="'$(Configuration)' == 'Release'">/native/</WasmShellWebAppBasePath>

    <!-- The platform's XAML resources that no page uses are trimmed from a published build: about 0.9 MB less on a
         first load (docs/architecture/18-native-client.md, "Size levers"). -->
    <UnoXamlResourcesTrimming Condition="'$(Configuration)' == 'Release'">true</UnoXamlResourcesTrimming>

    <!-- The calls into the browser are generated by the platform's own interop generator, which writes unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The offline deep-link check replaces the chosen server and then exits. A shipping build leaves it out. -->
  <PropertyGroup Condition="'$(DroverUnreachableCheck)' == 'true'">
    <DefineConstants>$(DefineConstants);DROVER_UNREACHABLE_CHECK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(DroverUnreachableCheck)' != 'true'">
    <Compile Remove="Shell/UnreachableOpenCheck.cs" />
  </ItemGroup>

  <!-- How requests reach the server. In a browser: the same-origin handler the web client uses. On a device: the
       handler and session the Android shell uses. Each is one source, compiled into both apps. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browserwasm'">
    <Compile Remove="Device/**" />
    <!-- Loaded by the page before the app starts. It keeps the platform's runtime within the content security policy. -->
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/NoEval.js" />
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Files.js" />
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Accessibility.js" />
    <Compile Include="../Shared/Transport/AntiforgeryHandler.cs" Link="Transport/AntiforgeryHandler.cs" />
  </ItemGroup>

  <!-- The page's start script, the cookie reader, notifications, the service worker, and the icons are the web
       client's own files, shared, so both behave the same: the stored theme from the first frame, a new build that
       takes over and reloads the page unless the person is writing, and notifications through the same worker. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browserwasm'">
    <Content Include="../Shared/Web/*.js;../Shared/Web/*.png;../Shared/Web/*.svg" Exclude="../Shared/Web/service-worker.published.js">
      <Link>%(Filename)%(Extension)</Link>
      <UnoDeploy>Root</UnoDeploy>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The page names its files relative to the folder it is served from, so an address deep in the app still finds
       them. The folder differs between a published build (/native/) and a development one (/). -->
  <Target Name="DroverIndexHtml"
          BeforeTargets="GenerateUnoWasmAssets"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browserwasm'">
    <PropertyGroup>
      <_DroverBasePath>$(WasmShellWebAppBasePath)</_DroverBasePath>
      <_DroverBasePath Condition="'$(_DroverBasePath)' == '' or '$(_DroverBasePath)' == './'">/</_DroverBasePath>
      <_DroverIndexHtml>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)index.html</_DroverIndexHtml>
      <_DroverIndexText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Platforms/WebAssembly/index.html').Replace('DROVER_BASE_PATH', '$(_DroverBasePath)'))</_DroverIndexText>
      <WasmShellIndexHtmlPath>$(_DroverIndexHtml)</WasmShellIndexHtmlPath>
    </PropertyGroup>
    <WriteLinesToFile File="$(_DroverIndexHtml)" Lines="$([MSBuild]::Escape('$(_DroverIndexText)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- A published build gets the web client's published service worker, with the list of the build's files and a
       hash of each that the worker stores at install. It takes the place of the platform's own worker, which is
       never registered (the platform's PWA switch is off). Runs after the platform's last change to the page. -->
  <Target Name="DroverServiceWorker"
          AfterTargets="Publish"
          DependsOnTargets="_UnoUpdateDotnetJsFingerprintPublishOutput;_UnoGeneratePreloadLinksPublishOutput"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browserwasm' and '$(WasmBuildingForNestedPublish)' != 'true'">
    <PropertyGroup>
      <_DroverWebRoot>$([System.IO.Path]::GetFullPath('$(PublishDir)'))wwwroot/</_DroverWebRoot>
      <_DroverAssetList>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)drover-shell-files.txt</_DroverAssetList>
    </PropertyGroup>
    <ItemGroup>
      <_DroverShellFile Include="$(_DroverWebRoot)**"
                        Exclude="$(_DroverWebRoot)**/*.br;$(_DroverWebRoot)**/*.gz;$(_DroverWebRoot)service-worker.js;$(_DroverWebRoot)service-worker-assets.js" />
    </ItemGroup>
    <GetFileHash Files="@(_DroverShellFile)" Algorithm="SHA256" HashEncoding="base64">
      <Output TaskParameter="Items" ItemName="_DroverHashedFile" />
    </GetFileHash>
    <ItemGroup>
      <_DroverHashedFile>
        <Url>$([MSBuild]::MakeRelative('$(_DroverWebRoot)', '%(FullPath)').Replace('%5C', '/'))</Url>
      </_DroverHashedFile>
      <_DroverAssetLine Include="@(_DroverHashedFile->'    { &quot;url&quot;: &quot;%(Url)&quot;, &quot;hash&quot;: &quot;sha256-%(FileHash)&quot; },')" />
    </ItemGroup>
    <WriteLinesToFile File="$(_DroverAssetList)" Lines="@(_DroverAssetLine)" Overwrite="true" />
    <GetFileHash Files="$(_DroverAssetList)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="_DroverShellVersion" />
    </GetFileHash>
    <WriteLinesToFile File="$(_DroverWebRoot)service-worker-assets.js"
                      Lines="self.assetsManifest = {;  &quot;version&quot;: &quot;$(_DroverShellVersion.Substring(0, 12))&quot;,;  &quot;assets&quot;: [;@(_DroverAssetLine);  ];}%3B"
                      Overwrite="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../Shared/Web/service-worker.published.js" DestinationFiles="$(_DroverWebRoot)service-worker.js" />
    <!-- The compressed copies are of the platform's worker, which is gone. -->
    <Delete Files="$(_DroverWebRoot)service-worker.js.br;$(_DroverWebRoot)service-worker.js.gz" />
  </Target>

  <!-- Holds what another app shared until a conversation takes it: the web client's, with this app's file type. -->
  <ItemGroup>
  </ItemGroup>

  <!-- The Android shell's notifications over UnifiedPush, shares in, files out, and what Android hands the activity:
       one source in both apps. The few things it asks of its host by that shell's framework's names are in
       Platforms/Android/AndroidShims.cs. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Compile Include="../Shared/Android/*.cs" Link="Platforms/Android/Shared/%(Filename)%(Extension)" />
    <AndroidResource Include="../Shared/Android/drover_notification.xml" Link="Platforms/Android/Resources/drawable/drover_notification.xml" />
    <Using Include="Android.App" />
    <Using Include="Android.Content" />
    <Using Include="Android.Content.PM" />
    <Using Include="Android.Runtime" />
    <Using Include="System.Buffers.Text" />
    <Using Include="System.Runtime.Versioning" />
    <Using Include="System.Security.Cryptography" />
    <Using Include="Drover.App.Platforms.Android" />
    <Using Include="Drover.Client.Push" />
    <Using Include="Drover.Contracts.Threads" />
    <Using Include="Drover.Native.Droid" />
    <Using Include="Drover.Ui.Pages.Tools" />
    <!-- Names both Android and this app's interface use, given to the interface's. -->
    <Using Include="Microsoft.UI.Xaml.Application" Alias="Application" />
    <Using Include="Drover.Native.Controls.Dialog" Alias="Dialog" />
    <Using Include="Android.App.Application" Alias="AndroidApplication" />
    <Using Include="Android.Net.Uri" Alias="AndroidUri" />
    <Using Include="Android.OS.Bundle" Alias="Bundle" />
    <Using Include="Drover.Native.Resource" Alias="Resource" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'browserwasm'">
    <Compile Include="../Shared/Transport/AppRequests.cs" Link="Transport/AppRequests.cs" />
    <Compile Include="../Shared/Transport/NativeSession.cs" Link="Transport/NativeSession.cs" />
    <Compile Include="../Shared/Transport/NativeSessionTokens.cs" Link="Transport/NativeSessionTokens.cs" />
    <Compile Include="../Shared/Transport/ServerAddress.cs" Link="Transport/ServerAddress.cs" />
  </ItemGroup>

  <!-- The screen checks run inside a build made for them, on a device or a desktop, and nowhere else: a product
       build never contains them. tests/Drover.Native.UITests starts the build with a test server to talk to. -->
  <ItemGroup Condition="'$(DroverUiChecks)' == 'true'">
    <Compile Include="../../tests/Drover.Native.UITests/App/*.cs" Link="UiChecks/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Drover.Contracts" />
    <TrimmerRootAssembly Include="Drover.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Drover.Client\Drover.Client.csproj" />
    <ProjectReference Include="..\Drover.Contracts\Drover.Contracts.csproj" />
    <ProjectReference Include="..\Drover.Presentation\Drover.Presentation.csproj" />
  </ItemGroup>

  <!-- The SDK adds two packages to every app that are not open source: its packaging helper, under an end-user
       agreement that forbids passing it on, and its account settings tool, which states no license. Neither is
       needed to build, run, or publish Drover, and Drover's license rule admits neither, so both are taken out
       of the package list before it is read. -->
  <Target Name="DropPackagesThatAreNotOpenSource" AfterTargets="UnoImplicitPackages">
    <ItemGroup>
      <PackageReference Remove="Uno.Sdk.Extras" />
      <PackageReference Remove="Uno.Settings.DevServer" />
    </ItemGroup>
  </Target>

</Project>
