<?xml version="1.0" encoding="utf-8"?>
<!-- The app talks to one HTTPS server and nothing else: clear text traffic is off, and no backup takes its data.
     Notifications arrive through a UnifiedPush distributor, which the app finds by the distributor's register action.
     The microphone is asked for the first time a person records a message or starts a call, never before, and a
     device without one still installs the app. A call tells the system a conversation is going on and sends its
     voice to the loudspeaker, which is what changing the audio settings is for. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-feature android:name="android.hardware.microphone" android:required="false" />
  <application android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false">
    <!-- Hands another app one conversation file to share, read-only, from the cache folder files are staged in. -->
    <provider android:name="androidx.core.content.FileProvider"
              android:authorities="${applicationId}.files"
              android:exported="false"
              android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/drover_file_paths" />
    </provider>
  </application>
  <queries>
    <!-- The retired Drover Preview app, which installing this one never replaced: the app asks the person to remove it. -->
    <package android:name="com.forresttechnologies.drover.preview" />
    <intent>
      <action android:name="org.unifiedpush.android.distributor.REGISTER" />
    </intent>
  </queries>
</manifest>
