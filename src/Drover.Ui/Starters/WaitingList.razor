@* Starter for #168. Everything that waits for the person, at the top of the Activity screen, shown only when
   something waits. Each call is its approval sentence with its arguments and can be answered in place. Several
   can be chosen and answered together, and the confirmation lists every one in full: there is no way to
   approve without the sentences in view. *@
@if (Calls.Count > 0)
{
    <section class="dv-waiting" aria-labelledby="@titleId">
        <h2 class="dv-waiting-title" id="@titleId">Waiting for you</h2>
        <ul class="dv-waiting-list">
            @foreach (var call in Calls)
            {
                <li class="dv-waiting-call dv-facet @(call.Decided is null ? "dv-waiting-open" : null)" @key="call.Id">
                    @if (call.Decided is null)
                    {
                        <label class="dv-waiting-choose">
                            <input type="checkbox" checked="@chosen.Contains(call.Id)" @onchange="change => Choose(call.Id, change.Value is true)" />
                            <span class="dv-visually-hidden">Choose: @call.Sentence</span>
                        </label>
                    }
                    <div class="dv-waiting-words">
                        <h3 class="dv-waiting-sentence" id="@SentenceId(call)">@call.Sentence</h3>
                        @if (call.Summary.Length > 0)
                        {
                            <p class="dv-waiting-summary dv-mono">@call.Summary</p>
                        }
                        <p class="dv-waiting-when dv-mono">@ScheduleWords.Moment(call.When)</p>
                        @if (call.Decided is { } decided)
                        {
                            <p class="dv-waiting-decided" role="status">@decided</p>
                        }
                        else
                        {
                            <div class="dv-waiting-actions">
                                <Button Kind="ButtonKind.Primary" Disabled="Deciding" OnClick="() => OnDecide.InvokeAsync(([call.Id], true))" aria-describedby="@SentenceId(call)">Approve</Button>
                                <Button Disabled="Deciding" OnClick="() => OnDecide.InvokeAsync(([call.Id], false))" aria-describedby="@SentenceId(call)">Deny</Button>
                            </div>
                        }
                    </div>
                </li>
            }
        </ul>
        @if (Chosen.Count > 0)
        {
            <div class="dv-waiting-bulk">
                <Button Kind="ButtonKind.Primary" Disabled="Deciding" OnClick="() => confirming = true">@ActivityWords.Bulk(true, Chosen.Count)</Button>
                <Button Disabled="Deciding" OnClick="() => confirming = false">@ActivityWords.Bulk(false, Chosen.Count)</Button>
            </div>
        }
        <StatusNote Kind="NoteKind.Danger" Text="@Problem" />
    </section>

    <Dialog Open="@(confirming is not null)" OpenChanged="open => confirming = open ? confirming : null" Title="@ActivityWords.Confirm(confirming ?? true, Chosen.Count)">
        <ChildContent>
            <ul class="dv-waiting-confirm">
                @foreach (var call in Chosen)
                {
                    <li @key="call.Id">
                        <span>@call.Sentence</span>
                        @if (call.Summary.Length > 0)
                        {
                            <span class="dv-mono">@call.Summary</span>
                        }
                    </li>
                }
            </ul>
        </ChildContent>
        <Actions>
            <Button Kind="ButtonKind.Primary" Disabled="@(Deciding || Chosen.Count is 0)" OnClick="DecideChosen">@ActivityWords.Bulk(confirming ?? true, Chosen.Count)</Button>
            <Button OnClick="() => confirming = null">Go back</Button>
        </Actions>
    </Dialog>
}

@code {
    #region Private Fields

    private readonly string titleId = $"dv-waiting-{Guid.NewGuid():N}";

    private readonly HashSet<Guid> chosen = [];

    // Null while nothing is being confirmed; otherwise whether the chosen calls would be approved or denied.
    private bool? confirming;

    #endregion

    #region Properties

    /// <summary>The calls that wait for this person, oldest first: the one that has waited longest leads.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<WaitingCall> Calls { get; set; } = [];

    /// <summary>True while answers are on their way to the server.</summary>
    [Parameter]
    public bool Deciding { get; set; }

    /// <summary>What went wrong with the last answer, such as a call that was answered elsewhere meanwhile.</summary>
    [Parameter]
    public string? Problem { get; set; }

    /// <summary>The person's answer for one or more calls: the calls, and whether they are approved.</summary>
    [Parameter]
    public EventCallback<(IReadOnlyList<Guid> Calls, bool Approved)> OnDecide { get; set; }

    // Only calls still waiting count: one answered elsewhere drops out of the selection by itself.
    private IReadOnlyList<WaitingCall> Chosen => [..Calls.Where(call => call.Decided is null && chosen.Contains(call.Id))];

    #endregion

    #region Private Methods

    // A call answered elsewhere, or gone, leaves the selection; with nothing left chosen, a confirmation in
    // progress is dropped instead of waiting to reappear when the next call arrives.
    protected override void OnParametersSet()
    {
        chosen.IntersectWith(Calls.Where(call => call.Decided is null).Select(call => call.Id));
        if (chosen.Count is 0)
        {
            confirming = null;
        }
    }

    private static string SentenceId(WaitingCall call) => $"dv-waiting-call-{call.Id:N}";

    private void Choose(Guid id, bool isChosen)
    {
        if (isChosen)
        {
            chosen.Add(id);
        }
        else
        {
            chosen.Remove(id);
        }
    }

    private async Task DecideChosen()
    {
        if (confirming is not { } approved || Chosen.Count is 0)
        {
            return;
        }

        IReadOnlyList<Guid> calls = [..Chosen.Select(call => call.Id)];
        confirming = null;
        chosen.Clear();
        await OnDecide.InvokeAsync((calls, approved));
    }

    #endregion
}
