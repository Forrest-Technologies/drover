@* Starter for #160. What a bot remembers about the person reading, beside its conversation. Every note is
   readable, says where it came from, and is changed in place. The panel has no filter and no folders: the
   notes are few by design, and a list short enough to read needs neither. *@
<div class="dv-memory">
    @switch (State)
    {
        case MemoryPanelState.Loading:
            <p class="dv-memory-hint" role="status">Loading what @BotName remembers.</p>
            break;
        case MemoryPanelState.Failed:
            <EmptyState Title="Drover could not load the notes" Cause="@(Problem ?? "The server did not answer.")" ActionLabel="Try again" OnAction="() => OnRetry.InvokeAsync()" />
            break;
        case MemoryPanelState.Off:
            <p class="dv-memory-hint">@MemoryWords.Off(BotName)</p>
            @if (EditorHref is not null)
            {
                <a class="dv-memory-link" href="@EditorHref">Turn memory on in @BotName's settings</a>
            }
            break;
        default:
            <StatusNote Kind="NoteKind.Danger" Text="@saveProblem" />
            <form class="dv-memory-add" @onsubmit="Add">
                <TextArea Label="Add a note" Rows="2" @bind-Value="adding" Hint="@($"Something {BotName} should know about you from now on.")" />
                <Button Type="submit" Kind="ButtonKind.Primary" Disabled="@string.IsNullOrWhiteSpace(adding)">Add the note</Button>
            </form>
            @if (NearlyFull)
            {
                <StatusNote Text="@MemoryWords.NearlyFull(BotName)" />
            }
            @if (Notes.Count is 0)
            {
                <p class="dv-memory-hint">@MemoryWords.Empty(BotName)</p>
            }
            else
            {
                <ul class="dv-memory-notes" aria-label="@($"What {BotName} remembers about you")">
                    @foreach (var note in Notes)
                    {
                        <li class="dv-memory-note dv-facet" @key="note.Id">
                            @if (editing == note.Id)
                            {
                                <form class="dv-memory-edit" @onsubmit="() => Save(note)">
                                    <TextArea Label="Note" Rows="3" @bind-Value="draft" />
                                    <div class="dv-memory-actions">
                                        <Button Type="submit" Kind="ButtonKind.Primary" Disabled="@string.IsNullOrWhiteSpace(draft)">Save</Button>
                                        <Button OnClick="() => (editing, saveProblem) = (null, null)">Cancel</Button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <p class="dv-memory-text">@note.Text</p>
                                <p class="dv-memory-origin dv-mono">
                                    @MemoryWords.Origin(note, BotName, ScheduleWords.Moment(note.When))
                                    @if (note.OriginHref is not null)
                                    {
                                        <a href="@note.OriginHref">Open that moment</a>
                                    }
                                </p>
                                <div class="dv-memory-actions">
                                    <Button OnClick="() => Edit(note)" aria-label="@($"Change the note: {note.Text}")">Change</Button>
                                    <Button OnClick="() => OnRemove.InvokeAsync(note.Id)" aria-label="@($"Remove the note: {note.Text}")">Remove</Button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
            break;
    }
</div>

@code {
    #region Private Fields

    private string adding = string.Empty;

    private Guid? editing;

    private string draft = string.Empty;

    // Why the last add or change was not saved. The text stays where it was typed, so nothing is lost.
    private string? saveProblem;

    #endregion

    #region Properties

    [Parameter, EditorRequired]
    public MemoryPanelState State { get; set; }

    [Parameter, EditorRequired]
    public string BotName { get; set; } = string.Empty;

    /// <summary>The notes, newest first.</summary>
    [Parameter]
    public IReadOnlyList<MemoryNote> Notes { get; set; } = [];

    [Parameter]
    public bool NearlyFull { get; set; }

    /// <summary>Why loading failed, as a sentence.</summary>
    [Parameter]
    public string? Problem { get; set; }

    /// <summary>The editor's Memory section, for a person who may change the bot. Null for everyone else.</summary>
    [Parameter]
    public string? EditorHref { get; set; }

    /// <summary>
    /// Saves a new note. Returns why it was not saved, or nothing when it was. Unlike an event callback this does
    /// not re-render the caller: the caller updates <see cref="Notes"/> itself once the note is saved.
    /// </summary>
    [Parameter]
    public Func<string, Task<string?>>? OnAdd { get; set; }

    /// <summary>
    /// Saves a changed note. Returns why it was not saved, or nothing when it was. As with <see cref="OnAdd"/>,
    /// the caller updates <see cref="Notes"/> itself.
    /// </summary>
    [Parameter]
    public Func<Guid, string, Task<string?>>? OnChange { get; set; }

    /// <summary>Removes at once. The caller offers Undo in a toast: a note is small and restoring it is exact.</summary>
    [Parameter]
    public EventCallback<Guid> OnRemove { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }

    #endregion

    #region Private Methods

    // The field empties only once the server has the note.
    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(adding) || OnAdd is null)
        {
            return;
        }

        saveProblem = await OnAdd(adding.Trim());
        if (saveProblem is null)
        {
            adding = string.Empty;
        }
    }

    private void Edit(MemoryNote note) => (editing, draft, saveProblem) = (note.Id, note.Text, null);

    // The note stays open for change until the server has it.
    private async Task Save(MemoryNote note)
    {
        if (string.IsNullOrWhiteSpace(draft) || OnChange is null)
        {
            return;
        }

        saveProblem = await OnChange(note.Id, draft.Trim());
        if (saveProblem is null)
        {
            editing = null;
        }
    }

    #endregion
}
