@* Starter for #152. A bot's changes, newest first. Each entry is a sentence and a time; opened, it shows every
   changed value before and after. Restore is offered only where it puts the definition back, and asks first in
   the caller's dialog. Grants, rules, and routines are shown and never restored from here. *@
@if (Entries.Count is 0)
{
    <p class="dv-history-hint">Nothing has changed on @BotName since it was made. Changes are listed here.</p>
}
else
{
    <ol class="dv-history" aria-label="@($"Changes to {BotName}, newest first")">
        @foreach (var entry in Entries)
        {
            <li @key="entry.Id">
                <Disclosure Title="@HistoryWords.Sentence(entry)" Summary="@ScheduleWords.Moment(entry.When)"
                            Open="@(open == entry.Id)" OpenChanged="value => open = value ? entry.Id : null">
                    <p class="dv-history-when dv-mono">@ScheduleWords.Moment(entry.When)</p>
                    @if (entry.Changes.Count is 0)
                    {
                        <p class="dv-history-hint">This change has no values to compare.</p>
                    }
                    @foreach (var change in entry.Changes)
                    {
                        <div class="dv-history-change">
                            <h4 class="dv-history-field">@HistoryWords.Heading(change.Field)</h4>
                            @if (HistoryWords.IsLong(change))
                            {
                                <DiffView Label="@HistoryWords.Heading(change.Field)" Before="@change.Before" After="@change.After" />
                            }
                            else
                            {
                                <dl class="dv-history-pair">
                                    <div><dt>Before</dt><dd>@(Shown(change.Before))</dd></div>
                                    <div><dt>After</dt><dd>@(Shown(change.After))</dd></div>
                                </dl>
                            }
                        </div>
                    }
                    @if (entry.CanRestore && CanChange)
                    {
                        <div>
                            <Button OnClick="() => OnRestore.InvokeAsync(entry.Id)">Restore the version before this change</Button>
                        </div>
                    }
                </Disclosure>
            </li>
        }
    </ol>
}

@code {
    #region Private Fields

    private Guid? open;

    #endregion

    #region Properties

    [Parameter, EditorRequired]
    public IReadOnlyList<HistoryEntry> Entries { get; set; } = [];

    [Parameter, EditorRequired]
    public string BotName { get; set; } = string.Empty;

    [Parameter]
    public bool CanChange { get; set; }

    /// <summary>The caller confirms in a dialog that lists what will change, then restores.</summary>
    [Parameter]
    public EventCallback<Guid> OnRestore { get; set; }

    #endregion

    #region Private Methods

    private static string Shown(string? value) => string.IsNullOrEmpty(value) ? "Nothing" : value;

    #endregion
}
