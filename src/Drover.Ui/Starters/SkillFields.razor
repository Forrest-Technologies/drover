@* Starter for #153 and #166. The three things a skill is. The same fields write a new skill in the library and
   let a person edit one a bot offers before saving it. *@
<div class="dv-skill-fields">
    <Field Label="Name" Value="@Draft.Name" ValueChanged="value => DraftChanged.InvokeAsync(Draft with { Name = value })" Disabled="Disabled" />
    <TextArea Label="When to use it" Rows="2" Value="@Draft.WhenToUse" ValueChanged="value => DraftChanged.InvokeAsync(Draft with { WhenToUse = value })"
              Hint="A bot always sees this line and reads it to decide whether the skill fits the work." Disabled="Disabled" />
    <TextArea Label="Steps" Rows="8" Value="@Draft.Steps" ValueChanged="value => DraftChanged.InvokeAsync(Draft with { Steps = value })"
              Hint="A bot reads these only once it has decided to use the skill." Disabled="Disabled" />
</div>

@code {
    [Parameter, EditorRequired]
    public SkillDraft Draft { get; set; } = SkillDraft.Empty;

    [Parameter]
    public EventCallback<SkillDraft> DraftChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}
