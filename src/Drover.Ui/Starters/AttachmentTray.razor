@* Starter for #151. The files chosen for a message, above the composer's field. Each says its state in words
   and can be taken off. Rendered only when there is a file. *@
@if (Items.Count > 0)
{
    <ul class="dv-attached" aria-label="Files attached to this message">
        @foreach (var item in Items)
        {
            <li class="dv-attached-file dv-facet @(Problem(item) ? "dv-attached-problem" : null)" @key="item.Id">
                <span class="dv-attached-words">
                    <span class="dv-attached-name">@item.Name</span>
                    <span class="dv-attached-status dv-mono">@FileWords.Status(item, BotName)</span>
                </span>
                <IconButton Icon="IconName.Close" Label="@($"Remove {item.Name}")" OnClick="() => OnRemove.InvokeAsync(item.Id)" />
            </li>
        }
    </ul>
    @* Progress is announced when a file finishes or fails, not percent by percent. *@
    <span class="dv-visually-hidden" role="status">@Announced</span>
}

@code {
    #region Properties

    [Parameter, EditorRequired]
    public IReadOnlyList<AttachmentItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public string BotName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<Guid> OnRemove { get; set; }

    private string Announced
    {
        get
        {
            var waiting = Items.Count(item => item.Phase is UploadPhase.Uploading);
            var stopped = Items.Count(Problem);
            return (waiting, stopped) switch
            {
                (0, 0) => $"{Words.Count(Items.Count, "file")} ready to send.",
                (0, _) => $"{Words.Count(stopped, "file")} cannot be sent.",
                _ => $"Uploading {Words.Count(waiting, "file")}.",
            };
        }
    }

    #endregion

    #region Private Methods

    private static bool Problem(AttachmentItem item) =>
        item.Phase is UploadPhase.Failed || item.Refusal is not FileRefusal.None;

    #endregion
}
