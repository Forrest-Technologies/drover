@* Starter for #148. How a failed run ends in the conversation: what failed in a sentence, one way forward,
   and what the server reported behind a disclosure for whoever needs it. *@
<section class="dv-failure dv-facet" aria-labelledby="@titleId">
    <h3 class="dv-failure-title" id="@titleId">@AttentionWords.Failure(Cause, BotName)</h3>
    <div class="dv-failure-actions">
        <Button Kind="ButtonKind.Primary" Disabled="Retrying" OnClick="() => OnRetry.InvokeAsync()">Try again</Button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Reported))
    {
        <Disclosure Title="What the server reported" Open="open" OpenChanged="value => open = value">
            <CodeBlock Code="@Reported" />
        </Disclosure>
    }
</section>

@code {
    #region Private Fields

    private readonly string titleId = $"dv-failure-{Guid.NewGuid():N}";

    private bool open;

    #endregion

    #region Properties

    [Parameter, EditorRequired]
    public FailureCause Cause { get; set; }

    [Parameter, EditorRequired]
    public string BotName { get; set; } = string.Empty;

    /// <summary>The error as the run's log holds it, already redacted. Shown only when asked for.</summary>
    [Parameter]
    public string? Reported { get; set; }

    [Parameter]
    public bool Retrying { get; set; }

    /// <summary>Starts a new run from the same message.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    #endregion
}
