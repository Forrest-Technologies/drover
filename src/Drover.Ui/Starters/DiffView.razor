@* Starter for #152. A before-and-after of a long text, line by line. A changed line is marked with a sign and a
   word for assistive technology as well as a color. *@
<div class="dv-diff" tabindex="0" role="group" aria-label="@($"{Label}. {LineDiff.Summary(lines)}")">
    @foreach (var line in lines)
    {
        <div class="dv-diff-line dv-diff-@line.Kind.ToString().ToLowerInvariant()">
            <span class="dv-diff-sign" aria-hidden="true">@Sign(line.Kind)</span>
            <span class="dv-visually-hidden">@Word(line.Kind)</span>
            <span class="dv-diff-text">@line.Text</span>
        </div>
    }
</div>

@code {
    #region Private Fields

    private IReadOnlyList<DiffLine> lines = [];

    #endregion

    #region Properties

    /// <summary>What is being compared, such as "Instructions".</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? Before { get; set; }

    [Parameter]
    public string? After { get; set; }

    #endregion

    #region Private Methods

    protected override void OnParametersSet() => lines = LineDiff.Between(Before, After);

    private static string Sign(DiffKind kind) => kind switch
    {
        DiffKind.Added => "+",
        DiffKind.Removed => "-",
        _ => " ",
    };

    private static string Word(DiffKind kind) => kind switch
    {
        DiffKind.Added => "Added: ",
        DiffKind.Removed => "Removed: ",
        _ => string.Empty,
    };

    #endregion
}
