@* Starter for #148. The word beside a bot's name in the crew column. Nothing is rendered when there is nothing
   to say, so a quiet crew stays quiet. *@
@if (AttentionWords.Word(Attention) is { } word)
{
    <span class="dv-attention"><Badge Kind="AttentionWords.Kind(Attention)">@word</Badge></span>
}

@code {
    [Parameter, EditorRequired]
    public Attention Attention { get; set; }
}
