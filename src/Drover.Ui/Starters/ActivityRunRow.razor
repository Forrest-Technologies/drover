@* Starter for #168. One run in the Activity list. The outcome leads, in words, because it decides what the
   person does next; then the bot, how the run started, and what was asked. Opened in place it shows the run's
   timeline, passed in by the caller, and a way to its conversation. *@
<Disclosure Title="@ActivityWords.Line(Run)" Summary="@ActivityWords.Timing(Run, ScheduleWords.Moment(Run.When))"
            Open="Open" OpenChanged="OpenChanged" Class="@(Run.Outcome is RunOutcome.Working ? "dv-run-working" : null)">
    <Status>
        <Badge Kind="ActivityWords.Kind(Run.Outcome)">@ActivityWords.Outcome(Run)</Badge>
    </Status>
    <ChildContent>
        <p class="dv-run-when dv-mono">@ActivityWords.Timing(Run, ScheduleWords.Moment(Run.When))</p>
        @if (Run.FailureSentence is { Length: > 0 } failure)
        {
            <p class="dv-run-failure">@failure</p>
        }
        @ChildContent
        <a class="dv-run-link" href="@Run.ConversationHref">Open the conversation</a>
    </ChildContent>
</Disclosure>

@code {
    [Parameter, EditorRequired]
    public ActivityRun Run { get; set; } = null!;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The run's timeline, the same component the activity rail shows.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
