@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<ArrowKeyZone> Logger

@* Starter for #164 and #167. A region whose arrow keys move between its own items. Blazor gets the key; this
   only stops the page behind from scrolling on the same press. Tab still leaves the region as usual. *@
<div @ref="zone" class="@Class" role="@Role" aria-label="@Label" @onkeydown="OnKey">
    @ChildContent
</div>

@code {
    #region Private Fields

    private const string ModulePath = "./_content/Drover.Ui/Starters/ArrowKeyZone.razor.js";

    private ElementReference zone;

    private IJSObjectReference? module;

    #endregion

    #region Properties

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>What the region is to assistive technology: "tree", "group".</summary>
    [Parameter]
    public string Role { get; set; } = "group";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKey { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    #endregion

    #region Public Methods

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            await module.DisposeAsync();
        }
    }

    #endregion

    #region Private Methods

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await module.InvokeVoidAsync("attach", zone);
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "The arrow key script failed to attach to its region");
            throw;
        }
    }

    #endregion
}
