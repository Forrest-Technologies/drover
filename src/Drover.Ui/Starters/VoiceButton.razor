@* Starter for #154. Speaking a message: one button beside send. While recording, the same place holds the
   time, a way to finish, and a way out. The words land in the composer to be checked; nothing is sent here. *@
<div class="dv-voice">
    @switch (Phase)
    {
        case VoicePhase.Recording:
            <span class="dv-voice-status dv-mono">@VoiceWords.Status(Phase, Elapsed)</span>
            <Button Kind="ButtonKind.Primary" OnClick="() => OnStop.InvokeAsync()">Stop and write it down</Button>
            <IconButton Icon="IconName.Close" Label="Cancel the recording" OnClick="() => OnCancel.InvokeAsync()" />
            break;
        case VoicePhase.Transcribing:
            <span class="dv-voice-status dv-mono">@VoiceWords.Status(Phase, Elapsed)</span>
            break;
        default:
            <IconButton Icon="IconName.Microphone" Label="Speak a message" OnClick="() => OnStart.InvokeAsync()" />
            break;
    }
    @* One live region for the phase, updated on change only: the running clock is not read out second by second. *@
    <span class="dv-visually-hidden" role="status">@Announced</span>
    <StatusNote Kind="NoteKind.Danger" Text="@VoiceWords.Problem(Problem)" />
</div>

@code {
    #region Properties

    [Parameter, EditorRequired]
    public VoicePhase Phase { get; set; }

    [Parameter]
    public TimeSpan Elapsed { get; set; }

    [Parameter]
    public VoiceProblem Problem { get; set; }

    [Parameter]
    public EventCallback OnStart { get; set; }

    [Parameter]
    public EventCallback OnStop { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string Announced => Phase switch
    {
        VoicePhase.Recording => "Recording.",
        VoicePhase.Transcribing => "Writing down what you said.",
        _ => string.Empty,
    };

    #endregion
}
