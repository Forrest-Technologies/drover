@* Samples for the starters that live in or beside a conversation. Every name and text here is a sample. *@
<GallerySection Title="A bot asks for its screen to be taken over (#150)" Note="The ask, the person holding the screen, and the answer given.">
    <TakeoverCard BotName="Sample bot" Reason="Sample reason: sign in to the sample site." Phase="TakeoverPhase.Asked" />
    <TakeoverCard BotName="Sample bot" Reason="Sample reason: sign in to the sample site." Phase="TakeoverPhase.Holding" />
    <TakeoverCard BotName="Sample bot" Reason="Sample reason: sign in to the sample site." Phase="TakeoverPhase.Done" />
</GallerySection>

<GallerySection Title="What a bot remembers (#160)" Note="Every note is readable, says where it came from, and is changed in place.">
    <div class="dv-sample-rail"><MemoryPanel State="MemoryPanelState.Ready" BotName="Sample bot" Notes="notes" NearlyFull="true" /></div>
    <div class="dv-sample-rail"><MemoryPanel State="MemoryPanelState.Ready" BotName="Sample bot" /></div>
    <div class="dv-sample-rail"><MemoryPanel State="MemoryPanelState.Off" BotName="Sample bot" EditorHref="/" /></div>
</GallerySection>

<GallerySection Title="Notifications on this device (#149)" Note="Each state says what is so. A state fixed outside Drover has no button.">
    <PushControl State="PushState.Off" />
    <PushControl State="PushState.On" />
    <PushControl State="PushState.Blocked" />
    <PushControl State="PushState.NeedsHomeScreen" />
</GallerySection>

<GallerySection Title="Speaking and hearing (#154)" Note="Idle, recording, writing it down, and a refusal. The words go to the composer, never straight to the bot.">
    <VoiceButton Phase="VoicePhase.Idle" />
    <VoiceButton Phase="VoicePhase.Recording" Elapsed="TimeSpan.FromSeconds(7)" />
    <VoiceButton Phase="VoicePhase.Transcribing" />
    <VoiceButton Phase="VoicePhase.Idle" Problem="VoiceProblem.PermissionRefused" />
    <ReadAloudButton />
    <ReadAloudButton Playing="true" />
</GallerySection>

@code {
    private static readonly DateTimeOffset sampleDay = new(2026, 1, 5, 8, 0, 0, TimeSpan.Zero);

    private static readonly MemoryNote[] notes =
    [
        new(Guid.Parse("00000000-0000-7000-8000-000000000301"), "Sample note: prefers short answers.", true, sampleDay, "/"),
        new(Guid.Parse("00000000-0000-7000-8000-000000000302"), "Sample note written by hand.", false, sampleDay.AddDays(-3), null),
    ];
}
