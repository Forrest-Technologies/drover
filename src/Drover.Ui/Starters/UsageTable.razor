@* Starter for #163. Which bot is spending, to decide what to change. A real table, cost first, the crew as the
   hierarchy it is, the biggest spender first at every level. No chart and no totals card: the question is "which
   bot", and the order answers it. On a phone each bot becomes a block with its figures labeled. *@
@if (UsageWords.IsEmpty(Crew))
{
    <p class="dv-usage-hint">No bot ran in this period.</p>
}
else
{
    <table class="dv-usage">
        <caption class="dv-visually-hidden">@Caption</caption>
        <thead>
            <tr>
                <th scope="col">Bot</th>
                <th scope="col">Cost</th>
                <th scope="col">Tokens in</th>
                <th scope="col">Tokens out</th>
                <th scope="col">Model</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in UsageWords.Rows(Crew))
            {
                <tr @key="row.Bot.BotId">
                    <th scope="row" class="dv-usage-who" style="--dv-usage-depth: @row.Depth">
                        <span class="dv-usage-bot">
                            <Avatar Name="@row.Bot.BotName" Hue="BotIdentity.Hue(row.Bot.BotId)" Size="24" />
                            <a href="@BotHref(row.Bot.BotId)">@row.Bot.BotName</a>
                        </span>
                    </th>
                    <td data-label="Cost">
                        <span class="dv-usage-own">@UsageWords.Money(row.Bot.Own.Cost, Currency)</span>
                        @if (row.Bot.WithBeneath is { } beneath)
                        {
                            <span class="dv-usage-beneath">@UsageWords.Money(beneath.Cost, Currency) with the bots beneath it</span>
                            @if (UsageWords.LeftOut(beneath) is { } leftOut)
                            {
                                <span class="dv-usage-beneath">@leftOut</span>
                            }
                        }
                    </td>
                    <td data-label="Tokens in" class="dv-usage-number">@UsageWords.Tokens(row.Bot.Own.TokensIn)</td>
                    <td data-label="Tokens out" class="dv-usage-number">@UsageWords.Tokens(row.Bot.Own.TokensOut)</td>
                    <td data-label="Model" class="dv-usage-model">@row.Bot.Model</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    #region Properties

    /// <summary>The bots at the top of the crew, each with the bots beneath it.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<UsageNode> Crew { get; set; } = [];

    /// <summary>The currency the catalog's prices are in, named beside every figure.</summary>
    [Parameter, EditorRequired]
    public string Currency { get; set; } = string.Empty;

    /// <summary>What the table shows and for when, such as "What each bot used in the last 7 days".</summary>
    [Parameter, EditorRequired]
    public string Caption { get; set; } = string.Empty;

    /// <summary>Where choosing a bot goes: its most expensive runs in the period.</summary>
    [Parameter, EditorRequired]
    public Func<Guid, string> BotHref { get; set; } = _ => string.Empty;

    #endregion
}
