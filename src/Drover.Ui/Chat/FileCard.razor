@* One file in a conversation. A picture is shown with its dimensions set; a text
   file shows its first lines, and all of it on "Show all"; anything else is a card. Every form has the same way to
   download it. Content a bot wrote is never rendered as a page here: it is shown as text or downloaded. *@
<figure class="dv-file">
    @switch (FileWords.Kind(File))
    {
        case FileKind.Image:
            <a class="dv-file-picture" href="@File.Href">
                <img src="@File.Href" width="@File.Width" height="@File.Height" alt="@(File.Caption ?? File.Name)" loading="lazy" />
            </a>
            break;
        case FileKind.Text:
            <div @ref="preview" class="dv-file-preview" tabindex="0" role="group" aria-label="@PreviewName">
                <pre class="dv-file-preview-text">@(whole?.Text ?? File.Preview)</pre>
            </div>
            @if (whole is { Cut: true })
            {
                <p class="dv-file-note">@FileWords.Cut(File.Name)</p>
            }
            else if (CanShowAll)
            {
                <div class="dv-file-more">
                    <Button aria-disabled="@(reading ? "true" : null)" aria-label="@(reading ? $"Loading all of {File.Name}" : $"Show all of {File.Name}")" OnClick="ShowAll">@(reading ? "Loading" : "Show all")</Button>
                </div>
            }
            <StatusNote Kind="NoteKind.Danger" Text="@problem" />
            break;
    }
    <figcaption class="dv-file-card dv-facet">
        <span class="dv-file-words">
            <span class="dv-file-name">@File.Name</span>
            <span class="dv-file-facts dv-mono">@FileWords.Facts(File)</span>
        </span>
        <a class="dv-file-get" href="@File.Href" download="@File.Name" aria-label="@($"Download {File.Name}")">
            <Icon Name="IconName.Download" />
            <span>Download</span>
        </a>
    </figcaption>
    @if (!string.IsNullOrWhiteSpace(File.Caption))
    {
        <p class="dv-file-caption">@File.Caption</p>
    }
</figure>

@code {
    #region Private Fields

    private ElementReference preview;

    private FileText? whole;

    private bool reading;

    private bool focusWhole;

    private string? problem;

    #endregion

    #region Properties

    [Parameter, EditorRequired]
    public SharedFile File { get; set; } = null!;

    /// <summary>Reads a text file's whole content, up to <see cref="FileWords.MaxShownCharacters"/>. Without it there is no "Show all".</summary>
    [Parameter]
    public Func<SharedFile, Task<FileText>>? ReadWhole { get; set; }

    private bool CanShowAll => ReadWhole is not null && whole is null && FileWords.HasMore(File);

    private string PreviewName => whole is null ? $"The first lines of {File.Name}" : $"All of {File.Name}";

    #endregion

    #region Private Methods

    // The button goes away once the text is in, so focus moves to the text it brought.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusWhole)
        {
            focusWhole = false;
            await preview.FocusAsync();
        }
    }

    // The button stays focusable while it reads, so focus is not lost; a second press meanwhile does nothing.
    private async Task ShowAll()
    {
        if (reading)
        {
            return;
        }

        reading = true;
        problem = null;

        try
        {
            whole = await ReadWhole!(File);
            focusWhole = true;
        }
        catch (Exception exception) when (Failures.IsReportable(exception))
        {
            problem = $"Drover could not load the rest of {File.Name}. {Failures.Sentence(exception)}";
        }
        finally
        {
            reading = false;
        }
    }

    #endregion
}
