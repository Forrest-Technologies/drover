<ul class="dv-side-chats">
    @foreach (var chat in Chats)
    {
        <li @key="chat.Id">
            <a class="dv-side-chat dv-facet" href="@chat.Href" aria-current="@(chat.Id == SelectedId ? "page" : null)">
                <Avatar Name="@chat.BotName" Hue="chat.BotHue" Size="24"
                        State="@(chat.Working ? AvatarState.Thinking : AvatarState.Rest)" />
                <span class="dv-side-chat-title">@chat.Title</span>
            </a>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SideChatItem> Chats { get; set; } = [];

    [Parameter]
    public Guid? SelectedId { get; set; }
}
