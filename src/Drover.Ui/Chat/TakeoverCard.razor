@* A bot asks a person to take over its screen and waits. Three moments, one card: the ask, the person holding the
   screen, and the answer given. Nothing moves while it waits: waiting is not a live state. *@
<section class="dv-takeover dv-facet @(Phase is TakeoverPhase.Asked or TakeoverPhase.Holding ? "dv-takeover-waits" : null)" aria-labelledby="@titleId">
    <div class="dv-takeover-head">
        <h3 class="dv-takeover-title" id="@titleId">@Title</h3>
        <Badge Kind="@(Phase is TakeoverPhase.Asked or TakeoverPhase.Holding ? BadgeKind.Warn : BadgeKind.Neutral)">@State</Badge>
    </div>
    <p class="dv-takeover-reason">@Reason</p>
    @switch (Phase)
    {
        case TakeoverPhase.Asked when Access is ScreenAccess.Usable:
            <div class="dv-takeover-actions">
                <Button Kind="ButtonKind.Primary" Disabled="Sending" OnClick="() => OnOpenScreen.InvokeAsync()" aria-describedby="@titleId">Open the screen</Button>
                <Button Disabled="Sending" OnClick="() => declining = true" aria-describedby="@titleId">I cannot do it</Button>
            </div>
            break;
        case TakeoverPhase.Asked when Access is ScreenAccess.NotPermitted:
            <p class="dv-takeover-note">Owners and admins of this space use @BotName's screen. Ask one of them to do it, then tell @BotName here.</p>
            <div class="dv-takeover-actions">
                <Button Disabled="Sending" OnClick="() => OnDone.InvokeAsync()" aria-describedby="@titleId">It is done</Button>
                <Button Disabled="Sending" OnClick="() => declining = true" aria-describedby="@titleId">I cannot do it</Button>
            </div>
            break;
        case TakeoverPhase.Asked when Access is ScreenAccess.Missing:
            <p class="dv-takeover-note">
                @BotName has no screen now, so this cannot be done there.
                @if (SetupHref is not null)
                {
                    <a href="@SetupHref">See what it needs.</a>
                }
            </p>
            <div class="dv-takeover-actions">
                <Button Disabled="Sending" OnClick="() => declining = true" aria-describedby="@titleId">I cannot do it</Button>
            </div>
            break;
        case TakeoverPhase.Asked when Access is ScreenAccess.Elsewhere:
            <p class="dv-takeover-note">
                @BotName works on a screen of its own. Open it from
                @if (SetupHref is not null)
                {
                    <a href="@SetupHref">its sandbox page</a>
                }
                else
                {
                    <text>its sandbox page</text>
                }, then tell @BotName here.
            </p>
            <div class="dv-takeover-actions">
                <Button Disabled="Sending" OnClick="() => OnDone.InvokeAsync()" aria-describedby="@titleId">It is done</Button>
                <Button Disabled="Sending" OnClick="() => declining = true" aria-describedby="@titleId">I cannot do it</Button>
            </div>
            break;
        case TakeoverPhase.Asked:
            <p class="dv-takeover-note" role="status">Checking whether you can use @BotName's screen.</p>
            break;
        case TakeoverPhase.Holding when AnswerBesideScreen:
            <p class="dv-takeover-note">Use I'm done at the screen when you have finished.</p>
            break;
        case TakeoverPhase.Holding:
            <p class="dv-takeover-note">What you type and click goes to the screen only and is not recorded. @BotName sees only what the screen shows when it next looks.</p>
            <div class="dv-takeover-actions">
                <Button @ref="done" Kind="ButtonKind.Primary" Disabled="Sending" OnClick="() => OnDone.InvokeAsync()" aria-describedby="@titleId">I'm done</Button>
                <Button Disabled="Sending" OnClick="() => declining = true" aria-describedby="@titleId">I could not do it</Button>
            </div>
            break;
    }
    @if (declining && Phase is TakeoverPhase.Asked or TakeoverPhase.Holding)
    {
        <form class="dv-takeover-decline" @onsubmit="Decline">
            <TextArea Label="@($"What got in the way (optional, {BotName} reads it)")" Rows="2" @bind-Value="note" />
            <div class="dv-takeover-actions">
                <Button Type="submit" Disabled="Sending">Tell @BotName I could not</Button>
                <Button Disabled="Sending" OnClick="() => declining = false">Back</Button>
            </div>
        </form>
    }
    <StatusNote Kind="NoteKind.Danger" Text="@Problem" />
</section>

@code {
    #region Private Fields

    private readonly string titleId = $"dv-takeover-{Guid.NewGuid():N}";

    private bool declining;

    private string note = string.Empty;

    private TakeoverPhase? seen;

    private Button? done;

    // Set when the card turns to holding with the controls here, so "I'm done" takes the focus once it is drawn.
    private bool focusDone;

    #endregion

    #region Properties

    [Parameter, EditorRequired]
    public string BotName { get; set; } = string.Empty;

    /// <summary>Why the bot needs a person, in the bot's own short words.</summary>
    [Parameter, EditorRequired]
    public string Reason { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public TakeoverPhase Phase { get; set; }

    /// <summary>True while an answer is on its way to the server.</summary>
    [Parameter]
    public bool Sending { get; set; }

    /// <summary>Why the answer could not be sent, as a sentence.</summary>
    [Parameter]
    public string? Problem { get; set; }

    /// <summary>Whether this person can open the bot's screen. Until it is known the card offers no answer.</summary>
    [Parameter]
    public ScreenAccess Access { get; set; } = ScreenAccess.Usable;

    /// <summary>Where the bot's screen is set up, for a bot that has none now.</summary>
    [Parameter]
    public string? SetupHref { get; set; }

    /// <summary>The screen is open beside the conversation with its own copy of the controls, so this one only points there.</summary>
    [Parameter]
    public bool AnswerBesideScreen { get; set; }

    /// <summary>"I'm done" takes the keyboard focus when the card turns to holding, as the control that replaced "Open the screen".</summary>
    [Parameter]
    public bool TakeFocus { get; set; }

    [Parameter]
    public EventCallback OnOpenScreen { get; set; }

    [Parameter]
    public EventCallback OnDone { get; set; }

    /// <summary>The person could not do it. The text is what they chose to tell the bot, and may be empty.</summary>
    [Parameter]
    public EventCallback<string> OnCouldNot { get; set; }

    private string Title => Phase switch
    {
        TakeoverPhase.Asked => $"{BotName} needs you at its screen",
        TakeoverPhase.Holding => $"You have {BotName}'s screen",
        TakeoverPhase.Done => $"You told {BotName} it is done",
        _ => $"You told {BotName} you could not do it",
    };

    private string State => Phase switch
    {
        TakeoverPhase.Asked => "Waiting for you",
        TakeoverPhase.Holding => $"{BotName} is waiting",
        TakeoverPhase.Done => "Done",
        _ => "Not done",
    };

    #endregion

    #region Private Methods

    protected override void OnParametersSet()
    {
        if (seen != Phase)
        {
            focusDone = TakeFocus && Phase is TakeoverPhase.Holding && !AnswerBesideScreen;
            (seen, declining, note) = (Phase, false, string.Empty);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDone && done is not null)
        {
            focusDone = false;
            await done.Focus();
        }
    }

    private async Task Decline()
    {
        declining = false;
        await OnCouldNot.InvokeAsync(note.Trim());
    }

    #endregion
}
