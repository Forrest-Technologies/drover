@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<MessageList> Logger

<div @ref="scroller" class="dv-messages" tabindex="0" role="group" aria-label="Conversation with @BotName">
    <div class="dv-messages-column">
        @if (Messages.Count == 0 && !Thinking)
        {
            <div class="dv-messages-start">
                <Avatar Name="@BotName" Hue="BotHue" Size="96" />
                <p>Nothing said yet. Write to @BotName below.</p>
            </div>
        }
        @foreach (var message in Messages)
        {
            if (message.FromPerson)
            {
                <article @key="message.Key" class="dv-message dv-message-person" aria-label="You said">
                    <p class="dv-message-bubble dv-facet">@message.Text</p>
                    @if (message.Pending)
                    {
                        <p class="dv-message-pending">Sent. @BotName reads it at its next step.</p>
                    }
                </article>
            }
            else if (message.Text.Length == 0)
            {
                <article @key="message.Key" class="dv-message dv-message-tools" aria-label="What @BotName did">
                    @foreach (var tool in message.Tools)
                    {
                        <ToolCallCard @key="tool.Id" Card="tool" BotName="@BotName" Decide="Decide" />
                    }
                </article>
            }
            else
            {
                <article @key="message.Key" class="dv-message dv-message-bot" aria-label="@BotName said">
                    <div class="dv-message-head dv-facet @(message.Streaming ? "dv-message-head-live" : null)">
                        <Avatar Name="@BotName" Hue="BotHue" Size="48" State="@(message.Streaming ? AvatarState.Writing : AvatarState.Rest)" />
                    </div>
                    <div class="dv-message-body">
                        <header class="dv-message-from">
                            <span class="dv-mono" aria-hidden="true">@BotName</span>
                            @if (message.Streaming)
                            {
                                <span class="dv-message-writing dv-mono" aria-hidden="true">Writing</span>
                            }
                        </header>
                        <MarkdownView Text="@message.Text" Streaming="message.Streaming" />
                        @foreach (var tool in message.Tools)
                        {
                            <ToolCallCard @key="tool.Id" Card="tool" BotName="@BotName" Decide="Decide" />
                        }
                    </div>
                </article>
            }
        }
        @if (Thinking)
        {
            <div class="dv-message dv-message-bot">
                <div class="dv-message-head dv-facet dv-message-head-live">
                    <Avatar Name="@BotName" Hue="BotHue" Size="48" State="AvatarState.Thinking" />
                </div>
                <div class="dv-message-body">
                    <div class="dv-message-from">
                        <span class="dv-mono" aria-hidden="true">@BotName</span>
                        <span class="dv-message-state dv-mono" aria-hidden="true">Thinking</span>
                    </div>
                </div>
            </div>
        }
        <StatusNote Kind="NoteKind.Danger" Text="@Problem" />
        <StatusNote Text="@Notice" />
    </div>
</div>
<div class="dv-visually-hidden" aria-live="polite">@spoken</div>

@code {
    #region Private Fields

    private const string ModulePath = "./_content/Drover.Ui/Chat/MessageList.razor.js";

    private readonly SentenceAnnouncer announcer = new();

    private readonly ToolAnnouncer tools = new();

    private ElementReference scroller;

    private Task<IJSObjectReference>? module;

    private string? spoken;

    #endregion

    #region Properties

    [Parameter, EditorRequired]
    public IReadOnlyList<ChatMessage> Messages { get; set; } = [];

    [Parameter, EditorRequired]
    public string BotName { get; set; } = string.Empty;

    [Parameter]
    public int BotHue { get; set; }

    /// <summary>True while the bot is working and has not started to answer.</summary>
    [Parameter]
    public bool Thinking { get; set; }

    /// <summary>Why the last reply failed and what to do, when it did.</summary>
    [Parameter]
    public string? Problem { get; set; }

    /// <summary>Something to know about the last reply that is not a failure, such as that it was stopped.</summary>
    [Parameter]
    public string? Notice { get; set; }

    /// <summary>Sends a person's answer to a tool call that waits for one. Returns why it failed, or nothing.</summary>
    [Parameter]
    public Func<Guid, bool, Task<string?>>? Decide { get; set; }

    #endregion

    #region Public Methods

    /// <summary>
    /// Brings the newest message into view. For when the person sends: they want to see what they wrote,
    /// wherever they had scrolled to. Replies do not call this, so reading further up is never interrupted.
    /// </summary>
    public async Task ShowNewest()
    {
        try
        {
            module ??= JS.InvokeAsync<IJSObjectReference>("import", ModulePath).AsTask();
            var loaded = await module;
            await loaded.InvokeVoidAsync("showNewest", scroller);
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "The message list script failed to show the newest message");
            throw;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            var loaded = await module;
            await loaded.DisposeAsync();
        }
    }

    #endregion

    #region Private Methods

    // Only a bot's newest message is read out, sentence by sentence. Older ones are already on the page. A tool call
    // is read out once each time its state changes.
    protected override void OnParametersSet()
    {
        var sentences = Messages is [.., { FromPerson: false } newest] ? announcer.Next(newest.Key, newest.Text, newest.Streaming) : null;
        var changes = tools.Next(Messages.AllTools(), BotName);
        spoken = (sentences, changes) switch
        {
            (null, null) => spoken,
            ({ } said, { } done) => $"{said} {done}",
            _ => sentences ?? changes,
        };
    }

    #endregion
}
