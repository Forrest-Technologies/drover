@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<MessageList> Logger

<div @ref="scroller" class="dv-messages" tabindex="0" role="group" aria-label="Conversation with @BotName">
    <div class="dv-messages-column">
        @if (Messages.Count == 0 && !Thinking)
        {
            <div class="dv-messages-start">
                <Avatar Name="@BotName" Hue="BotHue" Size="96" />
                <p>Nothing said yet. Write to @BotName below.</p>
            </div>
        }
        @foreach (var message in Messages)
        {
            <ChatEntry @key="message.Key" Message="message" BotName="@BotName" BotHue="BotHue" Asker="@Asker" Decide="Decide" Forget="Forget"
                       Anchor="@Anchor(message)" TabIndex="@MomentTabIndex(message)" ReadWhole="ReadWhole"
                       ForgottenNotes="ForgottenNotes" MemoryHref="@MemoryHref" Takeovers="Takeovers" />
        }
        @if (Thinking)
        {
            <div class="dv-message dv-message-bot">
                <div class="dv-message-head dv-facet dv-message-head-live">
                    <Avatar Name="@BotName" Hue="BotHue" Size="48" State="AvatarState.Thinking" />
                </div>
                <div class="dv-message-body">
                    <div class="dv-message-from">
                        <span class="dv-mono" aria-hidden="true">@BotName</span>
                        <span class="dv-message-state dv-mono" aria-hidden="true">Thinking</span>
                    </div>
                </div>
            </div>
        }
        @if (Failure is { } failure)
        {
            <FailureLine @key="failure.RunId" Cause="AttentionWords.CauseOf(failure.Cause)" BotName="@BotName"
                         Reported="@failure.Reported" Retrying="Retrying" OnRetry="OnRetry" />
        }
        <StatusNote Kind="NoteKind.Danger" Text="@Problem" />
        <StatusNote Text="@Notice" />
    </div>
</div>
<div class="dv-visually-hidden" aria-live="polite">@spoken</div>

@code {
    #region Private Fields

    private const string ModulePath = "./_content/Drover.Ui/Chat/MessageList.razor.js";

    private readonly SentenceAnnouncer announcer = new();

    private readonly ToolAnnouncer tools = new();

    private ElementReference scroller;

    private Task<IJSObjectReference>? module;

    private string? spoken;

    private Guid? announcedFailure;

    private Guid? shownMoment;

    #endregion

    #region Properties

    [Parameter, EditorRequired]
    public IReadOnlyList<ChatMessage> Messages { get; set; } = [];

    [Parameter, EditorRequired]
    public string BotName { get; set; } = string.Empty;

    [Parameter]
    public int BotHue { get; set; }

    /// <summary>The bot that wrote the messages a person would have, on a bot's side of work handed to it.</summary>
    [Parameter]
    public string? Asker { get; set; }

    /// <summary>True while the bot is working and has not started to answer.</summary>
    [Parameter]
    public bool Thinking { get; set; }

    /// <summary>Why the last reply failed and what to do, when it did.</summary>
    [Parameter]
    public string? Problem { get; set; }

    /// <summary>The run the conversation ends with, when it failed and nothing came after it.</summary>
    [Parameter]
    public RunFailure? Failure { get; set; }

    /// <summary>True while trying the failed run again is being asked for.</summary>
    [Parameter]
    public bool Retrying { get; set; }

    /// <summary>Starts a new run from the message the failed run answered.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Something to know about the last reply that is not a failure, such as that it was stopped.</summary>
    [Parameter]
    public string? Notice { get; set; }

    /// <summary>Sends a person's answer to a tool call that waits for one. Returns why it failed, or nothing.</summary>
    [Parameter]
    public Func<Guid, bool, Task<string?>>? Decide { get; set; }

    /// <summary>Removes a note the bot saved, from its card, while it still says the given text.</summary>
    [Parameter]
    public Func<Guid, string, Task<ForgetOutcome>>? Forget { get; set; }

    /// <summary>The notes forgotten from their cards, which then say so.</summary>
    [Parameter]
    public IReadOnlySet<Guid> ForgottenNotes { get; set; } = new HashSet<Guid>();

    /// <summary>The bot's memory beside the conversation, where a note that changed since its card can be seen.</summary>
    [Parameter]
    public string? MemoryHref { get; set; }

    /// <summary>Reads a text file's whole content for "Show all".</summary>
    [Parameter]
    public Func<SharedFile, Task<FileText>>? ReadWhole { get; set; }

    /// <summary>What a request for a person at the bot's screen needs here. Without it such a request is a plain tool card.</summary>
    [Parameter]
    public ScreenTakeovers? Takeovers { get; set; }

    /// <summary>The message the address points at, brought into view and focused once it is on the page.</summary>
    [Parameter]
    public Guid? Moment { get; set; }

    #endregion

    #region Public Methods

    /// <summary>
    /// Brings the newest message into view. For when the person sends: they want to see what they wrote,
    /// wherever they had scrolled to. Replies do not call this, so reading further up is never interrupted.
    /// </summary>
    public async Task ShowNewest()
    {
        try
        {
            module ??= JS.InvokeAsync<IJSObjectReference>("import", ModulePath).AsTask();
            var loaded = await module;
            await loaded.InvokeVoidAsync("showNewest", scroller);
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "The message list script failed to show the newest message");
            throw;
        }
    }

    /// <summary>The id a link to a message's moment names: <c>message-</c> and the message's id.</summary>
    public static string Anchor(Guid messageId) => $"message-{messageId}";

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            var loaded = await module;
            await loaded.DisposeAsync();
        }
    }

    #endregion

    #region Private Methods

    private static string Anchor(ChatMessage message) => $"message-{message.Key}";

    // The message a moment link names can take focus, so the person lands on it; no other message is a stop.
    private string? MomentTabIndex(ChatMessage message) => Moment is { } moment && message.Key == moment.ToString() ? "-1" : null;

    // A moment is shown once, when its message has arrived on the page.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A link followed again, after the person went elsewhere, lands again.
        if (Moment is null)
        {
            shownMoment = null;
        }

        if (Moment is not { } moment || moment == shownMoment || !Messages.Any(message => message.Key == moment.ToString()))
        {
            return;
        }

        shownMoment = moment;

        try
        {
            module ??= JS.InvokeAsync<IJSObjectReference>("import", ModulePath).AsTask();
            var loaded = await module;
            await loaded.InvokeVoidAsync("showMoment", Anchor(moment));
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "The message list script failed to show a moment");
            throw;
        }
    }

    // Only a bot's newest message is read out, sentence by sentence. Older ones are already on the page. A tool call
    // is read out once each time its state changes, and a failure once, when it appears.
    protected override void OnParametersSet()
    {
        var sentences = Messages is [.., { FromPerson: false } newest] ? announcer.Next(newest.Key, newest.Text, newest.Streaming) : null;
        var changes = tools.Next(Messages.AllTools(BotName));
        spoken = (sentences, changes) switch
        {
            (null, null) => spoken,
            ({ } said, { } done) => $"{said} {done}",
            _ => sentences ?? changes,
        };

        if (Failure is { } failure && failure.RunId != announcedFailure)
        {
            announcedFailure = failure.RunId;
            spoken = AttentionWords.Failure(AttentionWords.CauseOf(failure.Cause), BotName);
        }
    }

    #endregion
}
