@if (Card.Phase is ToolPhase.WaitingForYou)
{
    <section class="dv-tool-ask dv-facet" aria-labelledby="@askId">
        <div class="dv-tool-ask-head">
            <h2 class="dv-tool-ask-title" id="@askId">@BotName asks to @Card.Request</h2>
            <Badge Kind="BadgeKind.Warn">@Card.State</Badge>
        </div>
        @if (Card.Facts.Count > 0)
        {
            <dl class="dv-tool-facts">
                @foreach (var fact in Card.Facts)
                {
                    <div class="dv-tool-fact">
                        <dt>@fact.Name</dt>
                        <dd>@fact.Value</dd>
                    </div>
                }
            </dl>
        }
        else
        {
            @if (Card.Summary.Length > 0)
            {
                <p class="dv-tool-ask-summary dv-mono">@Card.Summary</p>
            }
            @if (!Card.ShowsAllArguments)
            {
                <CodeBlock Code="@Card.Arguments" Language="Arguments" />
            }
        }
        <div class="dv-tool-ask-actions">
            <Button Kind="ButtonKind.Primary" Disabled="deciding" OnClick="() => Answer(true)" aria-describedby="@askId">Approve</Button>
            <Button Disabled="deciding" OnClick="() => Answer(false)" aria-describedby="@askId">Deny</Button>
        </div>
        <StatusNote Kind="NoteKind.Danger" Text="@problem" />
    </section>
}
else
{
    <div class="dv-tool">
        <Disclosure Title="@Card.Label" Summary="@(Card.Summary.Length > 0 ? Card.Summary : null)" Open="open" OpenChanged="value => open = value"
                    Class="@FrameClass">
            <Status>
                <Badge Kind="StateKind">@Card.State</Badge>
            </Status>
            <ChildContent>
                @if (Card.Facts.Count > 0)
                {
                    <dl class="dv-tool-facts">
                        @foreach (var fact in Card.Facts)
                        {
                            <div class="dv-tool-fact">
                                <dt>@fact.Name</dt>
                                <dd>@fact.Value</dd>
                            </div>
                        }
                    </dl>
                }
                else if (Card.Arguments is not ("{}" or ""))
                {
                    <div class="dv-tool-part">
                        <h3 class="dv-tool-part-title">Arguments</h3>
                        <CodeBlock Code="@Card.Arguments" />
                    </div>
                }
                @if (Card.Output.Count > 0)
                {
                    <div class="dv-tool-part">
                        <h3 class="dv-tool-part-title">Output</h3>
                        @* Laid out bottom-up, so the newest line stays in view while output arrives. *@
                        <div class="dv-tool-output" tabindex="0" role="group" aria-label="Output">
                            <pre class="dv-tool-output-text">@foreach (var piece in Card.Output)
                                {
                                    if (piece.Stream is "stderr")
                                    {
                                        <span class="dv-tool-stderr"><span class="dv-tool-stream">stderr</span>@piece.Text</span>
                                    }
                                    else
                                    {
                                        <text>@piece.Text</text>
                                    }
                                }</pre>
                        </div>
                    </div>
                }
                @if (Card.ExitCode is not null || Card.Result is not null)
                {
                    <div class="dv-tool-part">
                        <h3 class="dv-tool-part-title">Result</h3>
                        @if (Card.ExitCode is { } exitCode)
                        {
                            <p class="dv-tool-exit">Exit code @exitCode</p>
                        }
                        @if (Card.Result is { } result)
                        {
                            <CodeBlock Code="@result" />
                        }
                    </div>
                }
                @if (Card.IsLive && Card.Output.Count == 0)
                {
                    <p class="dv-tool-quiet">No output yet.</p>
                }
            </ChildContent>
        </Disclosure>
        @if (Card.CommandError is { } commandError)
        {
            <p class="dv-tool-error">@commandError</p>
        }
        else if (!open && OutputPreview is { } preview)
        {
            <pre class="dv-tool-preview" aria-label="Command output preview">@preview</pre>
        }
        @if (Card.NoteId is { } noteId && Forget is not null)
        {
            <div class="dv-tool-note">
                @if (Forgotten)
                {
                    <p class="dv-tool-forgotten" tabindex="-1" @ref="forgottenLine">@MemoryWords.Forgotten</p>
                }
                else if (changedSince)
                {
                    <p class="dv-tool-forgotten" tabindex="-1" @ref="forgottenLine">
                        @MemoryWords.ChangedSince(BotName)
                        @if (MemoryHref is not null)
                        {
                            <a href="@MemoryHref">Open Memory to see it</a>
                        }
                    </p>
                }
                else
                {
                    <Button OnClick="() => ForgetNote(noteId)" aria-label="@($"Forget the note: {Card.NoteText}")">Forget</Button>
                }
                <StatusNote Kind="NoteKind.Danger" Text="@forgetProblem" />
            </div>
        }
    </div>
}

@code {
    #region Private Fields

    private string askId = string.Empty;

    private bool open;

    private bool deciding;

    private string? problem;

    private bool forgetting;

    // The note changed after the bot saved it, so Forget left it alone.
    private bool changedSince;

    private string? forgetProblem;

    private bool focusForgotten;

    private ElementReference forgottenLine;

    #endregion

    #region Properties

    [Parameter, EditorRequired]
    public ToolCard Card { get; set; } = null!;

    [Parameter, EditorRequired]
    public string BotName { get; set; } = string.Empty;

    /// <summary>Sends a person's answer to a call that waits for one. Returns why it failed, or nothing when it was sent.</summary>
    [Parameter]
    public Func<Guid, bool, Task<string?>>? Decide { get; set; }

    /// <summary>Removes the note a save kept, from its card, while it still says what the card shows.</summary>
    [Parameter]
    public Func<Guid, string, Task<ForgetOutcome>>? Forget { get; set; }

    /// <summary>True once the card's note was forgotten, until that is undone.</summary>
    [Parameter]
    public bool Forgotten { get; set; }

    /// <summary>The bot's memory, where a note that changed since this card can be seen.</summary>
    [Parameter]
    public string? MemoryHref { get; set; }

    private string? OutputPreview
    {
        get
        {
            if (Card.ExitCode is null || Card.Output.Count == 0)
            {
                return null;
            }

            const int previewLength = 240;
            var first = Card.Phase is ToolPhase.Failed
                ? Card.Output.FirstOrDefault(piece => piece.Stream is "stderr" && !string.IsNullOrWhiteSpace(piece.Text)) ?? Card.Output[0]
                : Card.Output[0];
            var text = first.Text.AsSpan().Trim();
            var end = text.IndexOfAny('\r', '\n');
            var length = Math.Min(end < 0 ? text.Length : end, previewLength);
            var line = text[..length].TrimEnd().ToString();
            return length < text.Length || Card.Output.Count > 1 ? $"{line}…" : line;
        }
    }

    // The frame's top edge: a traveling line while the tool runs, then green or red once it has finished.
    private string? FrameClass => Card.Phase switch
    {
        _ when Card.IsLive => "dv-state-tool",
        ToolPhase.Done => "dv-tool-ended dv-tool-ended-ok",
        ToolPhase.Failed => "dv-tool-ended dv-tool-ended-failed",
        ToolPhase.Interrupted => "dv-tool-ended dv-tool-ended-unknown",
        _ => null,
    };

    private BadgeKind StateKind => Card.Phase switch
    {
        _ when Card.IsLive => BadgeKind.Live,
        ToolPhase.Done => BadgeKind.Ok,
        ToolPhase.Failed => BadgeKind.Danger,
        ToolPhase.Interrupted => BadgeKind.Warn,
        _ => BadgeKind.Neutral,
    };

    #endregion

    #region Private Methods

    protected override void OnParametersSet()
    {
        askId = $"dv-tool-ask-{Card.Id:N}";
        if (Card.Phase is not ToolPhase.WaitingForYou)
        {
            (deciding, problem) = (false, null);
        }
    }

    private async Task Answer(bool approved)
    {
        if (Decide is null)
        {
            return;
        }

        // The buttons stay off once the answer is sent: the run's log turns the card into what happened next.
        (deciding, problem) = (true, null);
        problem = await Decide(Card.Id, approved);
        deciding = problem is null;
    }

    // The button is replaced by a line saying the note is gone, or that it changed since and so was kept, and the focus
    // moves to that line. The button stays enabled while the note is removed, so it keeps the focus if that fails; a
    // second press meanwhile does nothing.
    private async Task ForgetNote(Guid noteId)
    {
        if (Forget is null || forgetting)
        {
            return;
        }

        (forgetting, forgetProblem) = (true, null);
        var outcome = await Forget(noteId, Card.NoteText ?? string.Empty);
        (forgetting, changedSince, forgetProblem) = (false, outcome.Changed, outcome.Problem);
        focusForgotten = outcome.Forgotten || outcome.Changed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusForgotten && (Forgotten || changedSince))
        {
            focusForgotten = false;
            await forgottenLine.FocusAsync();
        }
    }

    #endregion
}
