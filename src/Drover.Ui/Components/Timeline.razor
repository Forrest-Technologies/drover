@* A run as a timeline: one lane for each bot, headed by its head and name, every event a node in time order
   down the page. Work handed to another bot branches across to that bot's lane in violet, and its answer comes
   back across at the row it returns on. The node being worked on carries its live state; nothing else moves.
   One tab stop: arrow keys move between nodes, Enter opens one. The nodes are a list in time order, each named
   as a sentence that starts with its bot, so a screen reader reads the same list the list form shows. The lane's
   hue is never the only way to tell lanes apart. A long run shows its newest events and pages back. *@
@if (Model.Nodes.Count is 0)
{
    <p class="dv-timeline-hint">@EmptyText</p>
}
else
{
    @if (First > 0)
    {
        <div class="dv-timeline-earlier">
            <p class="dv-timeline-hint">@Hidden</p>
            <Button OnClick="ShowEarlier">Show earlier events</Button>
        </div>
    }
    @if (AsList)
    {
        <ol class="dv-timeline-list" aria-label="@Label">
            @foreach (var node in Shown)
            {
                <li @key="node.Event.Id">
                    <Disclosure Title="@Timelines.Sentence(Model, node)" Summary="@node.Event.Summary" Open="@(opened == node.Event.Id)"
                                OpenChanged="value => opened = value ? node.Event.Id : null" Class="@Frame(node)">
                        @Detail?.Invoke(node)
                    </Disclosure>
                </li>
            }
        </ol>
    }
    else
    {
        <div class="dv-timeline">
            <ArrowKeyZone Label="@Label">
                <div class="dv-timeline-grid" style="--dv-timeline-lanes: @Model.Lanes.Count">
                    @foreach (var (bot, lane) in Model.Lanes.Select((bot, lane) => (bot, lane)))
                    {
                        <div class="dv-timeline-head" style="grid-column: @(lane + 1)" aria-hidden="true">
                            <Avatar Name="@bot.Name" Hue="BotIdentity.Hue(bot.Id)" Size="24" State="@HeadState(lane)" />
                            <span class="dv-timeline-name">@bot.Name</span>
                        </div>
                        <div class="dv-timeline-rail" style="grid-column: @(lane + 1); grid-row: 2 / span @(Shown.Count * 2); --dv-lane-hue: var(--dv-hue-@Hue(bot.Id))" aria-hidden="true"></div>
                    }
                    <ol class="dv-timeline-nodes" role="list">
                        @foreach (var node in Shown)
                        {
                            <li @key="node.Event.Id" class="dv-timeline-item" role="listitem">
                                @if (node.BranchLane is { } branch)
                                {
                                    <div class="dv-timeline-branch @(IsPassing(node) ? "dv-state-delegation" : null)" aria-hidden="true"
                                         style="grid-column: @(Math.Min(node.Lane, branch) + 1) / @(Math.Max(node.Lane, branch) + 1); grid-row: @(GridRow(node))"></div>
                                }
                                <button @ref="buttons[node.Event.Id]" type="button" data-arrow-item
                                        class="dv-timeline-node dv-facet @Frame(node) @(node.Event.Id == opened ? "dv-timeline-selected" : null)"
                                        style="grid-column: @(node.Lane + 1); grid-row: @(GridRow(node))"
                                        tabindex="@(node.Event.Id == Selected ? 0 : -1)" aria-expanded="@(opened == node.Event.Id ? "true" : "false")"
                                        aria-label="@Timelines.Sentence(Model, node)" @onclick="() => Toggle(node.Event.Id)" @onkeydown="key => OnKey(node, key)">
                                    @if (node.Event is { State: TimelineState.Live, Kind: TimelineKind.Step, Writing: false })
                                    {
                                        <span class="dv-timeline-breath dv-state-thinking" aria-hidden="true"></span>
                                    }
                                    <span class="dv-timeline-label">@node.Event.Label</span>
                                    @if (node.Event.Summary is { Length: > 0 } summary)
                                    {
                                        <span class="dv-timeline-summary dv-mono">@summary</span>
                                    }
                                    <Badge Kind="Timelines.Kind(node.Event.State)">@Timelines.State(node.Event.State)</Badge>
                                </button>
                                @if (opened == node.Event.Id)
                                {
                                    <div class="dv-timeline-detail" style="grid-row: @(GridRow(node) + 1)">
                                        @Detail?.Invoke(node)
                                    </div>
                                }
                            </li>
                        }
                    </ol>
                </div>
            </ArrowKeyZone>
        </div>
    }
}

@code {
    #region Private Fields

    private const int HueSteps = 12;

    private readonly Dictionary<Guid, ElementReference> buttons = [];

    // Kept by event, not by row: a late event with an earlier start moves rows, and must not move the selection.
    private Guid? selected;

    private (TimelineModel Model, int First, IReadOnlyList<TimelineNode> Nodes, HashSet<Guid> Ids)? shownFor;

    private Guid? opened;

    private bool moveFocus;

    // How many of the newest events are shown. It grows a page at a time, and to reach a node a key moved to.
    private int shownCount;

    #endregion

    #region Properties

    [Parameter, EditorRequired]
    public TimelineModel Model { get; set; } = TimelineModel.Empty;

    /// <summary>What this timeline is, such as "What happened in this run".</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>What to say when there is nothing to show, such as "Nothing has run in this conversation yet."</summary>
    [Parameter, EditorRequired]
    public string EmptyText { get; set; } = string.Empty;

    /// <summary>The same nodes as a list of sentences, each opening to its details.</summary>
    [Parameter]
    public bool AsList { get; set; }

    /// <summary>How many of the newest events show at first, and how many more each "Show earlier events" adds.</summary>
    [Parameter]
    public int PageSize { get; set; } = 200;

    /// <summary>A node's details: arguments, output as it streams, result, duration, cost.</summary>
    [Parameter]
    public RenderFragment<TimelineNode>? Detail { get; set; }

    // The row of the first event shown. Everything before it waits behind "Show earlier events".
    private int First => Math.Max(0, Model.Nodes.Count - Math.Max(shownCount, PageSize));

    // Worked out once per layout and page, not on every read: a render reads it once per node.
    private IReadOnlyList<TimelineNode> Shown
    {
        get
        {
            if (shownFor is not { } last || !ReferenceEquals(last.Model, Model) || last.First != First)
            {
                var nodes = First is 0 ? Model.Nodes : [.. Model.Nodes.Skip(First)];
                shownFor = (Model, First, nodes, nodes.Select(node => node.Event.Id).ToHashSet());
            }

            return shownFor.Value.Nodes;
        }
    }

    private string Hidden => First is 1 ? "1 earlier event is not shown." : $"{First} earlier events are not shown.";

    // The one node in the tab order: the one last moved to, or the first shown.
    private Guid? Selected => selected is { } id && Shown.Count > 0 && shownFor!.Value.Ids.Contains(id)
        ? id
        : Shown.FirstOrDefault()?.Event.Id;

    #endregion

    #region Private Methods

    private static int Hue(Guid botId) => ((BotIdentity.Hue(botId) % HueSteps) + HueSteps) % HueSteps;

    // The node's frame: the traveling line while a tool runs, violet while work is out with another bot, then
    // still in the result's color.
    private static string? Frame(TimelineNode node) => node.Event switch
    {
        { State: TimelineState.Live, Kind: TimelineKind.Tool } => "dv-state-tool",
        { State: TimelineState.Live, Kind: TimelineKind.Delegation } => "dv-timeline-handoff",
        { State: TimelineState.Live } => "dv-timeline-live",
        { State: TimelineState.Failed } => "dv-timeline-failed",
        { State: TimelineState.Waiting } => "dv-timeline-waiting",
        { Kind: TimelineKind.Delegation or TimelineKind.Answer } => "dv-timeline-handoff",
        _ => null,
    };

    // Work that is still out pulses once along its branch, when it is handed over; an answer pulses once coming back.
    private static bool IsPassing(TimelineNode node) => node.Event is { Kind: TimelineKind.Delegation, State: TimelineState.Live };

    // Each event takes two grid rows under the lane heads: its node, and the row its details open into.
    private int GridRow(TimelineNode node) => ((node.Row - First) * 2) + 2;

    // A lane's head shows what its bot is doing, as the bot's head does everywhere else: running a tool, writing,
    // or thinking. At rest it is dark.
    private AvatarState HeadState(int lane)
    {
        var live = Model.Nodes.Where(node => node.Lane == lane && node.Event.State is TimelineState.Live).Select(node => node.Event).ToList();
        return live switch
        {
            _ when live.Any(item => item.Kind is TimelineKind.Tool) => AvatarState.Tool,
            _ when live.Any(item => item is { Kind: TimelineKind.Step, Writing: true }) => AvatarState.Writing,
            _ when live.Any(item => item.Kind is TimelineKind.Step) => AvatarState.Thinking,
            _ => AvatarState.Rest,
        };
    }

    // An @ref is captured once, when its element is made, so a kept button's reference is kept too. Only an
    // event that left the run is forgotten.
    protected override void OnParametersSet()
    {
        foreach (var gone in buttons.Keys.Where(id => Model.Nodes.All(node => node.Event.Id != id)).ToList())
        {
            buttons.Remove(gone);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (moveFocus && Selected is { } id && buttons.TryGetValue(id, out var button))
        {
            moveFocus = false;
            await button.FocusAsync();
        }
    }

    private void OnKey(TimelineNode node, KeyboardEventArgs key)
    {
        var row = Timelines.Move(Model, node.Row, key.Key);
        var next = Model.Nodes[row].Event.Id;
        if (next == node.Event.Id)
        {
            return;
        }

        if (row < First)
        {
            shownCount = Model.Nodes.Count - row;
        }

        (selected, moveFocus) = (next, true);
    }

    private void ShowEarlier() => shownCount = Math.Max(shownCount, PageSize) + PageSize;

    private void Toggle(Guid id) => (selected, opened) = (id, opened == id ? null : id);

    #endregion
}
