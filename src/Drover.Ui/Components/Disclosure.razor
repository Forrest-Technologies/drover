<section class="dv-disclosure dv-facet @(Open ? "dv-disclosure-open" : null) @Class">
    <h2 class="dv-disclosure-heading">
        <button class="dv-disclosure-toggle" type="button" aria-expanded="@(Open ? "true" : "false")" aria-controls="@bodyId"
                @onclick="() => OpenChanged.InvokeAsync(!Open)">
            @if (Status is null)
            {
                <span class="dv-disclosure-title">@Title</span>
            }
            else
            {
                <span class="dv-disclosure-title-row">
                    <span class="dv-disclosure-title">@Title</span>
                    @Status
                </span>
            }
            @if (!Open && Summary is not null)
            {
                @* Read out between the title and the summary, so the two are heard as two things. *@
                <span class="dv-visually-hidden">, </span>
                <span class="dv-disclosure-summary dv-mono">@Summary</span>
            }
            <span class="dv-disclosure-mark"><Icon Name="@(Open ? IconName.ChevronDown : IconName.ChevronRight)" /></span>
        </button>
    </h2>
    <div class="dv-disclosure-body" id="@bodyId" hidden="@(!Open)">
        @if (Open)
        {
            @ChildContent
        }
    </div>
</section>

@code {
    private readonly string bodyId = $"dv-disclosure-{Guid.NewGuid():N}";

    /// <summary>What the section holds, in a word or two.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// One line that says what the section is set to. It is shown while the section is closed, inside the control
    /// that opens it, so it is read out with the title.
    /// </summary>
    [Parameter]
    public string? Summary { get; set; }

    /// <summary>
    /// What the thing the section is about is doing now, in words, shown after the title whether the section is
    /// open or closed.
    /// </summary>
    [Parameter]
    public RenderFragment? Status { get; set; }

    /// <summary>More classes for the frame, for a section that marks a state on its edge.</summary>
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
