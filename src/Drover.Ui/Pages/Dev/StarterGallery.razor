@page "/dev/starters"
@using Drover.Ui.Starters
@inject UiEnvironment Environment

@* The starters in src/Drover.Ui/Starters, shown in both themes. Development builds only. A starter's section is
   removed here in the pull request that moves the starter into the product. *@
@if (!Environment.IsDevelopment)
{
    <NotFound />
}
else
{
    <PageTitle>Starters</PageTitle>

    <main class="dv-gallery">
        <header class="dv-gallery-header">
            <h1>Starters</h1>
            <p>Designed pieces for screens that are not built yet, each named with the issue that finishes it. All names, text, and values on this page are samples.</p>
            <Badge>Sample content</Badge>
        </header>

        <ConversationSamples />
        <RoutineSamples />
        <RecordSamples />
        <BoldSamples />
    </main>
}
