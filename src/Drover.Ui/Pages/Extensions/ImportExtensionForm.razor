@* Importing an extension in two steps: choose the file, then read what it adds before saying yes. *@
<section class="dv-import dv-facet" aria-labelledby="@headingId">
    <h2 class="dv-import-title" id="@headingId">@(Preview is null ? "Import an extension" : $"Review {Preview.Name}")</h2>

    @if (Preview is null)
    {
        <form class="dv-import-step" @onsubmit="() => OnRead.InvokeAsync(text)">
            <div class="dv-import-file">
                <label class="dv-import-label" for="@fileId">Extension file</label>
                <InputFile class="dv-import-picker" id="@fileId" accept=".json,application/json" OnChange="Chosen" disabled="@Busy" />
            </div>
            <TextArea Label="Or paste its text" @bind-Value="text" Rows="6" Machine="true" Disabled="Busy" spellcheck="false"
                      Hint="Nothing is added by reading it. You see what it holds first." />
            <StatusNote Kind="NoteKind.Danger" Text="@(fileProblem ?? Problem)" />
            <div class="dv-import-actions">
                <Button OnClick="() => OnCancel.InvokeAsync()" Disabled="Busy">Cancel</Button>
                <Button Kind="ButtonKind.Primary" Type="submit" Disabled="@(Busy || string.IsNullOrWhiteSpace(text))">@(Busy ? "Reading the file" : "Read the file")</Button>
            </div>
        </form>
    }
    else
    {
        <form class="dv-import-step" @onsubmit="() => OnImport.InvokeAsync()">
            @if (!string.IsNullOrWhiteSpace(Preview.Description))
            {
                <p class="dv-import-about">@Preview.Description</p>
            }
            <p class="dv-import-id">Extension id <span class="dv-mono">@Preview.PackageId</span></p>

            @if (Preview.AlreadyInstalled)
            {
                <StatusNote Kind="NoteKind.Info" Text="This extension is already in this space, so it cannot be imported again." />
            }
            else if (Preview.Bot is { } bot)
            {
                <dl class="dv-import-facts">
                    <div>
                        <dt>Adds the bot</dt>
                        <dd>@bot.Name</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(bot.Description))
                    {
                        <div>
                            <dt>What it is for</dt>
                            <dd>@bot.Description</dd>
                        </div>
                    }
                    @if (bot.Model is not null)
                    {
                        <div>
                            <dt>Thinks with</dt>
                            <dd>@bot.Model on @bot.ModelConnection. You can change this in the bot's settings.</dd>
                        </div>
                    }
                    <div>
                        <dt>Tools</dt>
                        <dd>Only what every new bot starts with. The file cannot give it more.</dd>
                    </div>
                </dl>

                <div class="dv-import-instructions">
                    <h3 class="dv-import-label" id="@instructionsId">What the bot will be told, in full</h3>
                    @if (bot.HiddenCharacters > 0)
                    {
                        <StatusNote Kind="NoteKind.Danger" Text="@ExtensionWords.Hidden(bot.HiddenCharacters)" />
                    }
                    @if (string.IsNullOrEmpty(bot.Instructions))
                    {
                        <p class="dv-import-hint">The file gives this bot no instructions.</p>
                    }
                    else
                    {
                        <pre class="dv-import-text dv-mono" tabindex="0" aria-labelledby="@instructionsId">@bot.Instructions</pre>
                    }
                </div>

                @if (bot.Model is null)
                {
                    <p class="dv-import-hint">A bot needs a model to think with, and this space has none it can use yet. <a href="@Addresses.Models">Connect a model</a>, then import this.</p>
                }
            }

            <StatusNote Kind="NoteKind.Danger" Text="@Problem" />
            <div class="dv-import-actions">
                <Button OnClick="() => OnCancel.InvokeAsync()" Disabled="Busy">Cancel</Button>
                @if (Preview is { AlreadyInstalled: false, Bot.Model: not null })
                {
                    <Button Kind="ButtonKind.Primary" Type="submit" Disabled="Busy">@(Busy ? "Importing" : "Import, paused")</Button>
                }
            </div>
        </form>
    }
</section>

@code {
    private const long MaxFileBytes = 256 * 1024;

    private readonly string headingId = $"dv-import-{Guid.NewGuid():N}";

    private string fileId => $"{headingId}-file";

    private string instructionsId => $"{headingId}-instructions";

    private string text = string.Empty;

    private string? fileProblem;

    /// <summary>What the server read from the file. Null until a file has been read.</summary>
    [Parameter]
    public ExtensionPreview? Preview { get; set; }

    /// <summary>What the server said was wrong with the last attempt.</summary>
    [Parameter]
    public string? Problem { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<string> OnRead { get; set; }

    [Parameter]
    public EventCallback OnImport { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>Reads the chosen file into the text field, so a file and pasted text go the same way from here.</summary>
    private async Task Chosen(InputFileChangeEventArgs chosen)
    {
        fileProblem = null;

        if (chosen.File.Size > MaxFileBytes)
        {
            fileProblem = "This file is larger than an extension can be (256 KB).";
            return;
        }

        try
        {
            using var reader = new StreamReader(chosen.File.OpenReadStream(MaxFileBytes));
            text = await reader.ReadToEndAsync();
        }
        catch (IOException)
        {
            fileProblem = "The file could not be read. Choose it again, or paste its text.";
        }
    }
}
