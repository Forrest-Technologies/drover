@page "/extensions/edit"
@layout WorkLayout

<PageTitle>Make an extension · Drover</PageTitle>

<SessionGate>
    <header class="dv-extension-editor-header">
        <h1 class="dv-extension-editor-title">Make an extension</h1>
        <a class="dv-extension-editor-back" href="@Addresses.Extensions">Back to extensions</a>
    </header>

    @if (loadProblem is not null)
    {
        <EmptyState Title="Drover could not open this bot as an extension" Cause="@loadProblem" ActionLabel="Try again" OnAction="Load" />
    }
    else if (draft is null)
    {
        <p class="dv-extension-editor-hint" role="status">Opening the bot.</p>
    }
    else if (!CanEdit)
    {
        <p class="dv-extension-editor-hint">An owner or admin of the space can make an extension.</p>
    }
    else
    {
        <div class="dv-extension-editor dv-facet">
            <p class="dv-extension-editor-hint">Write a bot down so someone else can import it, with the tool server it uses if it has one. The file holds words and an address: no keys, no grants, no notes.</p>

            <Tabs Label="How the extension is shown" Items="tabs" Active="@tab" ActiveChanged="Show">
                @if (context.Id == JsonTab)
                {
                    <TextArea Label="The file as text" Value="@text" ValueChanged="EditText" Rows="18" Machine="true" Disabled="busy" spellcheck="false"
                              Hint="Changes here become the form when you go back to it." />
                }
                else
                {
                    <div class="dv-extension-editor-fields">
                        <Field Label="Extension name" Value="@draft.Name" ValueChanged="Rename" maxlength="@FieldLimits.BotName" autocomplete="off" Disabled="busy" />
                        <Field Label="Id" Value="@draft.Id" ValueChanged="ChooseId" maxlength="@ExtensionFile.MaxIdLength" autocomplete="off" spellcheck="false" Disabled="busy"
                               Hint="Names the extension wherever it is installed. Lower-case letters, digits, dots, and hyphens." />
                        <TextArea Label="What the extension is for" @bind-Value="draft.Description" Rows="2" Disabled="busy" maxlength="@FieldLimits.BotDescription" />

                        <h2 class="dv-extension-editor-part">The bot it adds</h2>
                        <Switch Label="Adds a bot" @bind-Value="draft.AddsBot" Disabled="busy" />
                        @if (draft.AddsBot)
                        {
                            <Field Label="Bot name" @bind-Value="draft.BotName" maxlength="@FieldLimits.BotName" autocomplete="off" Disabled="busy" />
                            <TextArea Label="What the bot is for" @bind-Value="draft.BotDescription" Rows="2" Disabled="busy" maxlength="@FieldLimits.BotDescription"
                                      Hint="Other bots read this to decide whether to hand it a task." />
                            <TextArea Label="Instructions" @bind-Value="draft.Instructions" Rows="10" Disabled="busy"
                                      Hint="Everything the bot is told. Whoever imports the file reads all of it first." />
                            <Field Label="Suggested model" @bind-Value="draft.SuggestedModel" maxlength="@FieldLimits.ModelName" autocomplete="off" spellcheck="false" Disabled="busy"
                                   Hint="Optional. Used only where the importing space has a model by this name." />
                        }

                        <h2 class="dv-extension-editor-part">The tool server it names</h2>
                        <Switch Label="Names a tool server" @bind-Value="draft.NamesServer" Disabled="busy" />
                        @if (draft.NamesServer)
                        {
                            <p class="dv-extension-editor-hint">The file says where the server is. It never holds a key: whoever imports it types their own.</p>
                            <Field Label="Server name" @bind-Value="draft.ServerName" maxlength="@FieldLimits.ToolServerName" autocomplete="off" Disabled="busy" Hint="What it is called, such as Calendar." />
                            <Field Label="Server address" Type="url" @bind-Value="draft.ServerAddress" autocomplete="off" spellcheck="false" Disabled="busy"
                                   Placeholder="https://" Hint="The address of the server's MCP endpoint, with nothing after the path." />
                            <div class="dv-extension-editor-choice">
                                <span class="dv-extension-editor-label" aria-hidden="true">How Drover proves who is calling</span>
                                <SegmentedControl Label="How Drover proves who is calling" Options="authKinds" @bind-Value="draft.ServerAuth" Disabled="busy" />
                            </div>
                            @if (draft.ServerAuth is "header")
                            {
                                <Field Label="Header name" @bind-Value="draft.HeaderName" maxlength="@FieldLimits.HeaderName" autocomplete="off" spellcheck="false" Disabled="busy"
                                       Hint="Such as Authorization or X-Api-Key. Its value is not part of the file." />
                            }
                            <TextArea Label="Tools to suggest for the bot" @bind-Value="draft.SuggestedTools" Rows="4" Machine="true" Disabled="busy" spellcheck="false"
                                      Hint="One a line: the tool's name as the server gives it, a colon, then why the bot needs it. Whoever imports the file chooses which the bot gets." />
                        }
                    </div>
                }
            </Tabs>

            <StatusNote Kind="@(noticeIsProblem ? NoteKind.Danger : NoteKind.Ok)" Text="@notice" />

            <div class="dv-extension-editor-actions">
                <Button OnClick="Check" Disabled="busy">@(busy ? "Checking" : "Check the file")</Button>
                <Button OnClick="Copy" Disabled="busy">Copy its text</Button>
                @if (CanDownload)
                {
                    <a class="dv-extension-editor-download" href="@DownloadAddress" download="@FileName">Download @FileName</a>
                }
                <Button Kind="ButtonKind.Primary" OnClick="Import" Disabled="busy">Import into this space</Button>
            </div>
        </div>
    }
</SessionGate>
