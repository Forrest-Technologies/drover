@page "/share"
@layout WorkLayout
@inject DroverApi Api
@inject SessionState Session
@inject ShareInbox Inbox
@inject NavigationManager Navigation
@inject ILogger<ShareTo> Logger

<PageTitle>Share to Drover · Drover</PageTitle>

@* This screen's job: choose which bot's conversation gets what another app shared, as a draft. *@
<SessionGate>
    <div class="dv-share">
        <h1 class="dv-share-title">Share to Drover</h1>
        @if (shared is null)
        {
            <EmptyState Cause="Nothing is waiting to be shared. Share text or a file to Drover from another app."
                        ActionLabel="Go to your crew" ActionHref="@Addresses.Home" />
        }
        else
        {
            <section class="dv-share-what dv-facet" aria-label="What you shared">
                @if (shared.Text.Length > 0)
                {
                    <p class="dv-share-text">@Excerpt</p>
                }
                @if (shared.Files.Count > 0)
                {
                    <ul class="dv-share-files">
                        @foreach (var file in shared.Files)
                        {
                            <li><span class="dv-share-file">@file.Name</span> <span class="dv-mono">@Words.Size(file.Size)</span></li>
                        }
                    </ul>
                }
            </section>

            @if (problem is not null)
            {
                <EmptyState Title="Drover could not load your crew" Cause="@problem" ActionLabel="Try again" OnAction="Load" />
            }
            else if (bots is null)
            {
                <p class="dv-share-note" role="status">Loading your crew.</p>
            }
            else if (bots.Count == 0)
            {
                <EmptyState Cause="There is no bot to share this with yet. Make one first; what you shared waits here."
                            ActionLabel="Go to your crew" ActionHref="@Addresses.Home" />
            }
            else
            {
                <h2 class="dv-share-ask" id="share-ask">Which bot gets this?</h2>
                <p class="dv-share-note">It opens as a draft in that bot's conversation. Nothing is sent until you send it.</p>
                <ul class="dv-share-bots" aria-labelledby="share-ask">
                    @foreach (var bot in bots)
                    {
                        <li @key="bot.Id">
                            <button type="button" class="dv-share-bot dv-facet" @onclick="() => Choose(bot)">
                                <Avatar Name="@bot.Name" Hue="BotIdentity.Hue(bot.Id)" Size="32" />
                                <span>@bot.Name</span>
                            </button>
                        </li>
                    }
                </ul>
            }

            <div class="dv-share-actions">
                <Button OnClick="Discard">Discard what you shared</Button>
            </div>
        }
    </div>
</SessionGate>

@code {
    #region Private Fields

    private const int ExcerptLength = 400;

    private SharedDraft? shared;

    private IReadOnlyList<BotSummary>? bots;

    private string? problem;

    #endregion

    #region Properties

    // Long text is shown from its start: enough to know it is the right thing. The whole of it goes into the draft.
    private string Excerpt => shared!.Text.Length > ExcerptLength ? $"{shared.Text[..ExcerptLength]}…" : shared.Text;

    #endregion

    #region Private Methods

    protected override async Task OnInitializedAsync()
    {
        shared = Inbox.Waiting;

        if (shared is not null && await Session.Load() is not null)
        {
            await Load();
        }
    }

    private async Task Load()
    {
        problem = null;

        try
        {
            bots = await Api.ListBots(Session.Space!.Id);
        }
        catch (Exception exception) when (Failures.IsReportable(exception))
        {
            Logger.LogWarning(exception, "A request to the server failed on the {Screen} screen", nameof(ShareTo));
            problem = Failures.Sentence(exception);
        }
    }

    private void Choose(BotSummary bot)
    {
        Inbox.SendTo(bot.Id);
        Navigation.NavigateTo(Addresses.Talk(bot.Id));
    }

    private void Discard()
    {
        Inbox.Discard();
        Navigation.NavigateTo(Addresses.Home);
    }

    #endregion
}
