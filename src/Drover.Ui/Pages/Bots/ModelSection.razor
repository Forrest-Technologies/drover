@* The Model section of the bot editor: which model the bot thinks with, and only the settings that model has. *@
<Select Label="Connection" Value="@Draft.ModelConnectionId.ToString()" ValueChanged="ChooseConnection">
    @foreach (var connection in Connections)
    {
        <option value="@connection.Id">@connection.Name</option>
    }
</Select>

@if (Models is null)
{
    <p class="dv-editor-hint" role="status">Loading the models of this connection.</p>
}
else if (Choices.Count > 0 && !enterModelId)
{
    <Select Label="Model" Value="@Draft.Model" ValueChanged="ChooseModel">
        @if (!Choices.Any(entry => entry.Model == Draft.Model))
        {
            <option value="@Draft.Model">@Draft.Model</option>
        }
        @foreach (var entry in Choices)
        {
            <option value="@entry.Model">@entry.DisplayName</option>
        }
    </Select>
}
else
{
    <Field Label="Model name" Value="@Draft.Model" ValueChanged="ChooseModel" autocomplete="off" spellcheck="false"
           Hint="@(enterModelId ? "Enter the model ID your provider expects." : "This connection does not list its models. Type the name it expects.")" />
}

@if (Models is not null && Choices.Count > 0)
{
    <div>
        <Button OnClick="ToggleModelEntry">@(enterModelId ? "Choose from the catalog" : "Enter a model ID")</Button>
    </div>
}

<p class="dv-editor-hint"><a href="@Addresses.Models">Manage model connections</a></p>

@if (Known is null && Models is not null)
{
    <p class="dv-editor-hint">Drover does not know what this model can do, so only the settings every model has are shown.</p>
}

@* A model that cannot see images uses a screen through another model that reads it, with the centre of each thing to click. *@
@if (ReaderShown)
{
    @if (Readers is null)
    {
        <p class="dv-editor-hint" role="status">The models that can read the screen are not known yet.</p>
    }
    else if (Readers.Count == 0 && Draft.ScreenReader is null)
    {
        <p class="dv-editor-hint">This model cannot see images, and no model of this space is listed as reading them, so no other model can read the screen for this bot.</p>
    }
    else
    {
        <Select Label="Reads the screen for this bot" Value="@ReaderValue" ValueChanged="ChooseReader">
            <option value="">@OwnModel</option>
            @if (Draft.ScreenReader is { } stored && Chosen is null)
            {
                <option value="@ScreenReaderChoice.ValueOf(stored.ModelConnectionId, stored.Model)">@stored.Model</option>
            }
            @foreach (var connection in Readers.GroupBy(reader => (reader.ConnectionId, reader.ConnectionName)))
            {
                <optgroup label="@connection.Key.ConnectionName">
                    @foreach (var reader in connection)
                    {
                        <option value="@reader.Value">@reader.DisplayName</option>
                    }
                </optgroup>
            }
        </Select>
        <p class="dv-editor-hint">@ReaderHint</p>
        @if (!Draft.Desktop)
        {
            <div class="dv-editor-sandbox-grant">
                <p class="dv-editor-hint">It is used when this bot has a screen. Give it a sandbox with Desktop on, in the Sandbox section.</p>
                <Button OnClick="() => OnOpenSection.InvokeAsync(SandboxSection)">Open the Sandbox section</Button>
            </div>
        }
    }
}

@if (Known is { ReasoningEfforts.Count: > 0 } reasoning)
{
    <Select Label="Reasoning effort" @bind-Value="Draft.ReasoningEffort" @bind-Value:after="Changed">
        <option value="">Left to the model</option>
        @foreach (var effort in reasoning.ReasoningEfforts)
        {
            <option value="@effort">@effort</option>
        }
    </Select>
}

@if (Known is { WebSearch: true })
{
    <div class="dv-editor-choice">
        <span class="dv-editor-choice-label" aria-hidden="true">Built-in web search</span>
        <SegmentedControl Label="Built-in web search" Options="webSearch" @bind-Value="Draft.WebSearch" @bind-Value:after="Changed" />
    </div>
}

@if (Known is { StructuredOutput: true })
{
    <Switch Label="Answer as a JSON object" @bind-Value="Draft.StructuredOutput" @bind-Value:after="Changed" />
    @if (Draft.StructuredOutput && Connections.FirstOrDefault(connection => connection.Id == Draft.ModelConnectionId)?.Kind is "venice")
    {
        <p class="dv-editor-hint">Applies when tools are unavailable.</p>
    }
}

<div class="dv-editor-pair">
    <Field Label="Temperature" @bind-Value="Draft.Temperature" @bind-Value:after="Changed" inputmode="decimal" autocomplete="off"
           Placeholder="Left to the model" Hint="0 is steady, 2 is loose." />
    <Field Label="Longest answer, in tokens" @bind-Value="Draft.MaxOutputTokens" @bind-Value:after="Changed" inputmode="numeric" autocomplete="off"
           Placeholder="Left to the model" Hint="@(Known?.MaxOutputSize is { } most ? $"This model writes at most {most}." : null)" />
</div>

@code {
    private static readonly SegmentOption<string>[] webSearch = [new("off", "Off"), new("automatic", "When needed"), new("on", "Always")];

    private bool enterModelId;

    [Parameter, EditorRequired]
    public BotDraft Draft { get; set; } = new();

    [Parameter, EditorRequired]
    public IReadOnlyList<ModelConnectionSummary> Connections { get; set; } = [];

    /// <summary>The models the chosen connection lists, or null while they load.</summary>
    [Parameter]
    public IReadOnlyList<ModelCatalogResponse>? Models { get; set; }

    /// <summary>Whether the bot's model can see images: null while unknown, false when it cannot or is not in the catalog.</summary>
    [Parameter]
    public bool? ModelSeesImages { get; set; }

    /// <summary>
    /// The space's models that can read the screen for this bot, those the catalog lists as reading images, or null
    /// while they are not known.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ScreenReaderChoice>? Readers { get; set; }

    /// <summary>Opens another section of the editor, by name.</summary>
    [Parameter]
    public EventCallback<string> OnOpenSection { get; set; }

    /// <summary>Raised after the draft changed, so the page can show that there is something to save.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Raised when another connection is chosen, so the page can load that connection's models.</summary>
    [Parameter]
    public EventCallback<Guid> OnConnectionChosen { get; set; }

    private IReadOnlyList<ModelCatalogResponse> Choices =>
        [.. (Models ?? []).Where(entry => entry.State is "available").OrderBy(entry => entry.DisplayName, StringComparer.OrdinalIgnoreCase)];

    private ModelCapabilitiesResponse? Known => Models?.FirstOrDefault(entry => entry.Model == Draft.Model)?.Capabilities;

    private const string SandboxSection = "Sandbox";

    // Offered wherever it can matter: a reader is set, or the model cannot see and there is a model that can, or the
    // bot has a screen it cannot see. A bot that sees for itself and has none set is not asked.
    private bool ReaderShown =>
        Draft.ScreenReader is not null
        || (ModelSeesImages is false && (Draft.Desktop || Readers is { Count: > 0 }));

    private ScreenReaderChoice? Chosen =>
        Draft.ScreenReader is { } reader
            ? Readers?.FirstOrDefault(choice => choice.ConnectionId == reader.ModelConnectionId && choice.Model == reader.Model)
            : null;

    private string ReaderValue => Draft.ScreenReader is { } reader ? ScreenReaderChoice.ValueOf(reader.ModelConnectionId, reader.Model) : string.Empty;

    private string OwnModel => ModelSeesImages is false ? "Its own model (cannot read images)" : "Its own model";

    private string ReaderHint => Draft.ScreenReader is null
        ? "This model cannot see images. Choose a model that can, and it reads each screenshot for the bot: what is on the screen, and where to click."
        : $"The bot gets a description of each screenshot in words instead of the picture. That is slower and less exact than a model that sees for itself, and each screenshot is also a call to {Chosen?.DisplayName ?? Draft.ScreenReader.Model}.";

    private Task ChooseReader(string value)
    {
        Draft.ScreenReader = ScreenReaderChoice.Read(value);
        return Changed();
    }

    private Task Changed() => OnChanged.InvokeAsync();

    private void ToggleModelEntry() => enterModelId = !enterModelId;

    private async Task ChooseConnection(string id)
    {
        if (Guid.TryParse(id, out var connectionId) && connectionId != Draft.ModelConnectionId)
        {
            enterModelId = false;
            Draft.ModelConnectionId = connectionId;
            await OnConnectionChosen.InvokeAsync(connectionId);
        }
    }

    private Task ChooseModel(string model)
    {
        Draft.Model = model;
        Draft.KeepWhatModelSupports(Known);
        return Changed();
    }
}
