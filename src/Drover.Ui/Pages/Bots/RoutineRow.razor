@* One routine: when it runs as a sentence, what it is sent, when it runs next, how the last run went, and its
   controls. The sentence is the row's heading, so it is what is read out first. *@
<article class="dv-routine dv-facet" aria-labelledby="@titleId">
    <div class="dv-routine-head">
        <h3 class="dv-routine-when" id="@titleId">@Sentence</h3>
        @if (RoutineWords.Describe(Routine.Cron) is null)
        {
            <code class="dv-routine-cron dv-mono">@Routine.Cron</code>
        }
    </div>
    @if (wholePrompt)
    {
        <p class="dv-routine-prompt dv-routine-prompt-whole" id="@promptId">@Routine.Prompt</p>
    }
    else
    {
        <p class="dv-routine-prompt" id="@promptId">@RoutineWords.FirstLine(Routine.Prompt)</p>
    }
    @if (!CanRewrite && RoutineWords.FirstLine(Routine.Prompt) != Routine.Prompt.Trim())
    {
        <div>
            <Button OnClick="() => wholePrompt = !wholePrompt" aria-expanded="@(wholePrompt ? "true" : "false")"
                    aria-controls="@promptId" aria-describedby="@titleId">Read the whole prompt</Button>
        </div>
    }
    <dl class="dv-routine-facts">
        <div class="dv-routine-fact">
            <dt>Next</dt>
            <dd>@Next</dd>
        </div>
        <div class="dv-routine-fact">
            <dt>Last</dt>
            <dd>
                @Last
                @if (Routine.LastRun?.ConversationHref is { } href)
                {
                    <a class="dv-routine-link" href="@href">Open that conversation</a>
                }
            </dd>
        </div>
    </dl>
    @if (StartedHref is { } started)
    {
        <p class="dv-routine-started">Started once now, as you. <a class="dv-routine-link" href="@started" @ref="startedLink">Open the conversation it started</a></p>
    }
    @if (CanChange)
    {
        <div class="dv-routine-actions">
            <Switch Label="Runs on its own" About="@($"{Sentence}: {RoutineWords.FirstLine(Routine.Prompt)}")" Value="Routine.Enabled" ValueChanged="value => OnEnabledChanged.InvokeAsync(value)" Disabled="Busy" />
            <Button OnClick="() => OnRunOnce.InvokeAsync()" Disabled="Busy" aria-describedby="@titleId">Run once now</Button>
            @if (CanRewrite)
            {
                <Button OnClick="() => OnChange.InvokeAsync()" Disabled="Busy" aria-describedby="@titleId">Change</Button>
            }
            <Button Kind="ButtonKind.Danger" OnClick="() => OnRemove.InvokeAsync()" Disabled="Busy" aria-describedby="@titleId">Remove</Button>
        </div>
        @if (!CanRewrite)
        {
            <p class="dv-routine-note">Only the person who made it can change what it sends or when, because it runs as them.</p>
        }
    }
    <StatusNote Kind="NoteKind.Danger" Text="@Problem" />
</article>

@code {
    #region Private Fields

    private string titleId = string.Empty;

    private string promptId = string.Empty;

    private bool wholePrompt;

    private ElementReference startedLink;

    private string? focusedStarted;

    #endregion

    #region Properties

    [Parameter, EditorRequired]
    public RoutineItem Routine { get; set; } = null!;

    [Parameter, EditorRequired]
    public string BotName { get; set; } = string.Empty;

    /// <summary>A paused bot's routines do not run, and the row says so in place of the next time.</summary>
    [Parameter]
    public bool BotPaused { get; set; }

    /// <summary>Owners and admins change routines. Everyone else reads them.</summary>
    [Parameter]
    public bool CanChange { get; set; }

    /// <summary>
    /// Only the person who made a routine changes what it sends or when, because it runs as them. Another owner or
    /// admin may turn it off, run it once as themselves, or remove it.
    /// </summary>
    [Parameter]
    public bool CanRewrite { get; set; } = true;

    /// <summary>True while a change to this section is being asked for.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>The conversation a run started from this row went to, once it started.</summary>
    [Parameter]
    public string? StartedHref { get; set; }

    /// <summary>Moves focus to the link to that conversation once it appears, for a run started from a dialog.</summary>
    [Parameter]
    public bool FocusStarted { get; set; }

    /// <summary>What the server said when it refused this row's last action, as a sentence.</summary>
    [Parameter]
    public string? Problem { get; set; }

    [Parameter]
    public EventCallback<bool> OnEnabledChanged { get; set; }

    [Parameter]
    public EventCallback OnRunOnce { get; set; }

    [Parameter]
    public EventCallback OnChange { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    private string Next => (Routine.Enabled, BotPaused, Routine.NextRun) switch
    {
        (false, _, _) => "Off. It does not run until it is turned on.",
        (_, true, _) => $"Does not run while {BotName} is paused.",
        (_, _, { } next) => $"Runs {RoutineWords.Moment(next, Routine.TimeZone)}",
        _ => "Drover has not worked out the next time yet.",
    };

    private string Sentence => RoutineWords.Sentence(Routine.Cron, Routine.TimeZone);

    private string Last =>
        RoutineWords.Outcome(Routine.LastRun, Routine.LastRun is { } last ? RoutineWords.Moment(last.When, Routine.TimeZone) : string.Empty);

    #endregion

    #region Private Methods

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusStarted && StartedHref is { } started && started != focusedStarted)
        {
            focusedStarted = started;
            await startedLink.FocusAsync();
        }
    }

    protected override void OnParametersSet() =>
        (titleId, promptId) = ($"dv-routine-{Routine.Id:N}", $"dv-routine-prompt-{Routine.Id:N}");

    #endregion
}
