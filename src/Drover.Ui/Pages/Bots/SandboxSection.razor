@* The Sandbox section of the bot editor: whether the bot has a place to run code and keep files, and who shares it. *@
@* The note's live region stays in place; only its text comes and goes. *@
<StatusNote Text="@(Options.Available ? null : NoProvider)" />

@if (Status is { Available: true, HasSandbox: true } live)
{
    <p class="dv-editor-sandbox-live">
        <span>@SandboxWords.Summary(live, DateTimeOffset.UtcNow)</span>
        <a href="@Addresses.BotSandbox(BotId)">Open the sandbox</a>
    </p>
}

<Select Label="Sandbox" @bind-Value="Draft.SandboxPolicy" @bind-Value:after="Changed">
    @foreach (var policy in policies)
    {
        <option value="@policy">@BotSummaries.SandboxPolicy(policy)</option>
    }
</Select>
<p class="dv-editor-hint">@Meaning</p>

@if (Draft.SandboxPolicy is "named")
{
    @if (OtherBots.Count == 0)
    {
        <p class="dv-editor-hint">There is no other bot in this space to share with yet.</p>
    }
    else
    {
        <fieldset class="dv-editor-checks">
            <legend class="dv-editor-checks-legend">Share with</legend>
            @foreach (var bot in OtherBots)
            {
                <label class="dv-editor-check" @key="bot.Id">
                    <input type="checkbox" checked="@Draft.SandboxSharedWith.Contains(bot.Id)" @onchange="change => Share(bot.Id, change.Value is true)" />
                    <span>@bot.Name</span>
                </label>
            }
        </fieldset>
    }
}

@if (Draft.SandboxPolicy is not "none")
{
    <div class="dv-editor-choice">
        <span class="dv-editor-choice-label" aria-hidden="true">Network</span>
        <SegmentedControl Label="Sandbox network" Options="Networks" @bind-Value="Draft.Network" @bind-Value:after="Changed" />
    </div>

    @if (!Options.OpenNetwork)
    {
        <p class="dv-editor-hint">Open internet access is not available on this server.</p>
    }

    @if (Draft.Network is "allowlist")
    {
        <TextArea Label="Hosts it may reach" Machine="true" Rows="3" @bind-Value="Draft.AllowedHosts" @bind-Value:after="Changed"
                  Hint="One host name to a line, such as example.com." spellcheck="false" autocapitalize="off" />
    }

    <Field Label="Stop after idle minutes" @bind-Value="Draft.IdleTimeoutMinutes" @bind-Value:after="Changed" inputmode="numeric" autocomplete="off"
           Placeholder="@IdlePlaceholder" />

    @* A bot already set to have a screen keeps the switch, so it can be turned off; the server refuses to save it on. *@
    @if (Options.Desktop || Draft.Desktop)
    {
        <Switch Label="Desktop" @bind-Value="Draft.Desktop" @bind-Value:after="Changed" />
        <p class="dv-editor-hint">@DesktopHint</p>
    }

    @if (Draft.Desktop)
    {
        @if (Readers is null)
        {
            <p class="dv-editor-hint" role="status">The models that can read the screen are not known yet.</p>
        }
        else if (Readers.Count == 0 && Draft.ScreenReader is null)
        {
            <p class="dv-editor-hint">No model of this space is listed as reading images, so no other model can read the screen for this bot.</p>
            <p class="dv-editor-hint"><a href="@Addresses.SetupModel">Connect a model</a></p>
        }
        else
        {
            <Select Label="Reads the screen for this bot" Value="@ReaderValue" ValueChanged="ChooseReader">
                <option value="">@OwnModel</option>
                @if (Draft.ScreenReader is { } stored && Chosen is null)
                {
                    <option value="@ScreenReaderChoice.ValueOf(stored.ModelConnectionId, stored.Model)">@stored.Model</option>
                }
                @foreach (var connection in Readers.GroupBy(reader => (reader.ConnectionId, reader.ConnectionName)))
                {
                    <optgroup label="@connection.Key.ConnectionName">
                        @foreach (var reader in connection)
                        {
                            <option value="@reader.Value">@reader.DisplayName</option>
                        }
                    </optgroup>
                }
            </Select>
            @if (Draft.ScreenReader is not null)
            {
                <p class="dv-editor-hint">@ReaderHint</p>
            }
        }
    }

    @if (!Options.Desktop)
    {
        <p class="dv-editor-hint">A sandbox with a screen is not available on this server.</p>
    }

    @if (Options.Available && SandboxStanding is not ToolStanding.Unknown)
    {
        <div class="dv-editor-sandbox-grant" role="group" aria-label="What this bot may do in its sandbox">
            <p class="dv-editor-hint">@Words(SandboxStanding, SandboxGrants.SandboxTools, sandboxWords)</p>
            @if (SandboxStanding is ToolStanding.NotAllowed)
            {
                <Button Kind="ButtonKind.Primary" OnClick="() => Allow(SandboxGrants.SandboxTools)">Allow sandbox tools</Button>
            }
            else if (SandboxStanding is ToolStanding.Allowed)
            {
                <Button OnClick="() => OnOpenSection.InvokeAsync(ToolsSection)">Open the Tools section</Button>
            }
        </div>
    }

    @if (Options.Available && Draft.Desktop && ScreenStanding is not ToolStanding.Unknown)
    {
        <div class="dv-editor-sandbox-grant" role="group" aria-label="What this bot may do on its screen">
            <p class="dv-editor-hint">@Words(ScreenStanding, SandboxGrants.ScreenTools, screenWords)</p>
            @if (ScreenStanding is ToolStanding.NotAllowed)
            {
                <Button Kind="ButtonKind.Primary" OnClick="() => Allow(SandboxGrants.ScreenTools)">Allow screen tools</Button>
            }
            else if (ScreenStanding is ToolStanding.Allowed)
            {
                <Button OnClick="() => OnOpenSection.InvokeAsync(ToolsSection)">Open the Tools section</Button>
            }
        </div>
    }

    @if (Draft.Desktop && ModelSeesImages is false && Draft.ScreenReader is null)
    {
        <div class="dv-editor-sandbox-grant">
            <StatusNote Text="@CannotSee" />
            <Button OnClick="() => OnOpenSection.InvokeAsync(ModelSection)">Open the Model section</Button>
        </div>
    }
}

@code {
    private const string NoProvider =
        "No sandbox provider is set up on this server, so no bot has a sandbox to use yet. This choice is saved for when one is added.";

    private static readonly string[] policies =["none", "private", "subtree", "named"];

    private static readonly SegmentOption<string>[] allNetworks = [new("off", "Off"), new("allowlist", "Named hosts"), new("open", "Open")];

    private static readonly SegmentOption<string>[] closedNetworks = [.. allNetworks.Where(network => network.Value is not "open")];

    [Parameter, EditorRequired]
    public BotDraft Draft { get; set; } = new();

    [Parameter, EditorRequired]
    public Guid BotId { get; set; }

    /// <summary>The bot's sandbox as it is now: its state and last use, with a way to its screen. Null until known.</summary>
    [Parameter]
    public BotSandboxStatus? Status { get; set; }

    /// <summary>The space's other bots, which a sandbox can be shared with.</summary>
    [Parameter]
    public IReadOnlyList<BotSummary> OtherBots { get; set; } = [];

    /// <summary>What a sandbox on this server may be. Until it is known, nothing is hidden.</summary>
    [Parameter]
    public BotSandboxOptions Options { get; set; } = new(Available: true, OpenNetwork: true, MaxIdleMinutes: 0, Desktop: true);

    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>The tools with this bot's grants, as the Tools section shows them, or null while they load.</summary>
    [Parameter]
    public IReadOnlyList<BotToolEntry>? Tools { get; set; }

    /// <summary>Whether the bot's model can see images: null while unknown, false when it cannot or is not in the catalog.</summary>
    [Parameter]
    public bool? ModelSeesImages { get; set; }

    /// <summary>
    /// The space's models that can read the screen for this bot, those the catalog lists as reading images, or null
    /// while they are not known.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ScreenReaderChoice>? Readers { get; set; }

    /// <summary>Opens another section of the editor, by name: "Tools" or "Model".</summary>
    [Parameter]
    public EventCallback<string> OnOpenSection { get; set; }

    private const string ToolsSection = "Tools";

    private const string ModelSection = "Model";

    private static readonly ToolWords sandboxWords = new(
        "This bot may not use its sandbox yet. Allow its sandbox tools to let it run commands and use files.",
        "The sandbox tools will be allowed when you save.",
        "May run commands and use files.",
        "use its sandbox",
        "sandbox tools");

    private static readonly ToolWords screenWords = new(
        "This bot may not use the screen yet. Allow its screen tools to let it see and drive the screen.",
        "The screen tools will be allowed when you save.",
        "May use the screen.",
        "use the screen",
        "screen tools");

    private ToolStanding SandboxStanding => SandboxGrants.Standing(Tools, SandboxGrants.SandboxTools, Draft.StagedGrants);

    private ToolStanding ScreenStanding => SandboxGrants.Standing(Tools, SandboxGrants.ScreenTools, Draft.StagedGrants);

    private string Words(ToolStanding standing, IReadOnlyList<string> names, ToolWords words) => standing switch
    {
        ToolStanding.NotAllowed => words.NotAllowed,
        ToolStanding.AllowedOnSave => words.OnSave,
        ToolStanding.ParentForbids =>
            $"{SandboxGrants.Forbidder(Tools, names) ?? "The bot above this one"} does not allow the {words.Tools}, so this bot cannot {words.Use}.",
        _ => SandboxGrants.Asks(Tools, names, Draft.StagedGrants) ? $"{words.Allowed} It asks a person before each use." : words.Allowed,
    };

    private Task Allow(IReadOnlyList<string> names)
    {
        Draft.StagedGrants = SandboxGrants.Stage(Tools, names, Draft.StagedGrants);
        return Changed();
    }

    private sealed record ToolWords(string NotAllowed, string OnSave, string Allowed, string Use, string Tools);

    // A bot already set to open keeps the choice visible, so the editor shows what is stored; the server refuses to save it.
    private SegmentOption<string>[] Networks => Options.OpenNetwork || Draft.Network is "open" ? allNetworks : closedNetworks;

    private string IdlePlaceholder => Options.MaxIdleMinutes > 0 ? $"Up to {Options.MaxIdleMinutes}" : "The server's own limit";

    private string Meaning => Draft.SandboxPolicy switch
    {
        "private" => "Only this bot uses its sandbox. Nothing another bot does can touch its files.",
        "subtree" => "This bot and every bot beneath it work in the same files and can change each other's work.",
        "named" => "The bots you choose work in the same files as this one and can change its work.",
        _ => "This bot runs no code and keeps no files of its own.",
    };

    private const string DesktopHint =
        "Gives the sandbox a screen the bot sees in screenshots and uses with the mouse and keyboard. It costs more to run. Screenshots go to a model as they are, so they can show anything on that screen, passwords included. Changing this replaces the sandbox, and its files, on its next use.";

    private ScreenReaderChoice? Chosen =>
        Draft.ScreenReader is { } reader
            ? Readers?.FirstOrDefault(choice => choice.ConnectionId == reader.ModelConnectionId && choice.Model == reader.Model)
            : null;

    private string ReaderValue => Draft.ScreenReader is { } reader ? ScreenReaderChoice.ValueOf(reader.ModelConnectionId, reader.Model) : string.Empty;

    private string OwnModel => ModelSeesImages is false ? "Its own model (cannot read images)" : "Its own model";

    private string CannotSee => Readers is { Count: > 0 }
        ? "The model this bot uses cannot see images, so the bot cannot use the screen. Choose a model to read the screen for it above, or a model that can see in the Model section."
        : "The model this bot uses cannot see images, so the bot cannot use the screen. Choose a model that can in the Model section.";

    private string ReaderHint =>
        $"The bot gets a description of each screenshot in words instead of the picture. That is slower and less exact than a model that sees for itself, and each screenshot is also a call to {Chosen?.DisplayName ?? Draft.ScreenReader!.Model}.";

    private Task ChooseReader(string value)
    {
        Draft.ScreenReader = ScreenReaderChoice.Read(value);
        return Changed();
    }

    private Task Changed() => OnChanged.InvokeAsync();

    private Task Share(Guid botId, bool shared)
    {
        Draft.SandboxSharedWith = shared
            ? [.. Draft.SandboxSharedWith.Append(botId).Distinct()]
            : [.. Draft.SandboxSharedWith.Where(id => id != botId)];
        return Changed();
    }
}
