@page "/"
@page "/talk/{BotId:guid}"
@page "/talk/{BotId:guid}/{Rail}"
@page "/talk/{BotId:guid}/side/{SideChat}"
@page "/talk/{BotId:guid}/activity/{ActivityRunId:guid}"
@page "/talk/{BotId:guid}/work/{WorkBotId:guid}/{WorkThreadId:guid}"
@page "/threads/{FormerThreadId:guid}"

<PageTitle>@PageName</PageTitle>

<SessionGate>
    <div class="dv-shell dv-shell-at-@At @(Side is SideView.Closed ? null : "dv-shell-with-rail") @(Side is SideView.Screen or SideView.Activity ? "dv-shell-with-wide-rail" : null)">
        <div class="dv-shell-list">
            <header class="dv-shell-list-header">
                <span class="dv-wordmark"><DroverMark />Drover</span>
            </header>
            <nav class="dv-shell-crew" aria-label="Crew">
                @if (At is "crew")
                {
                    <h1 class="dv-visually-hidden">Conversations</h1>
                }
                @if (NotReady is not null)
                {
                    <div class="dv-shell-narrow-only">@NotReady</div>
                }
                else
                {
                    <CrewList Crew="Crew" SelectedId="Shown?.Id" Working="WorkingBots" ForYou="ForYou" Handoffs="Handoffs" />
                }
            </nav>
            <footer class="dv-shell-list-footer">
                <a class="dv-shell-bots" href="@Addresses.Bots">Bots</a>
                <a class="dv-shell-bots" href="@Addresses.Tools">Tools</a>
                <AccountMenu />
            </footer>
        </div>
        <main class="dv-shell-main dv-yard">
            @if (NotReady is not null)
            {
                <div class="dv-shell-center">@NotReady</div>
            }
            else if (formerMissing)
            {
                <div class="dv-shell-center">
                    <EmptyState Title="This conversation is not here" Cause="It was removed, or it belongs to someone else."
                                ActionLabel="Back to the crew" ActionHref="@Addresses.Home" />
                </div>
            }
            else if (Shown is null)
            {
                <div class="dv-shell-center">
                    <EmptyState Title="This bot is not here" Cause="It was removed, or it belongs to another space."
                                ActionLabel="Back to the crew" ActionHref="@Addresses.Home" />
                </div>
            }
            else if (FormerThreadId is null)
            {
                <header class="dv-shell-main-header">
                    <a class="dv-shell-back" href="@Addresses.Home" aria-label="Back to the crew">
                        <Icon Name="IconName.ArrowLeft" Size="20" />
                    </a>
                    <Avatar Name="@Shown.Name" Hue="BotIdentity.Hue(Shown.Id)" Size="48"
                            State="@(mainBusy ? AvatarState.Thinking : AvatarState.Rest)" />
                    @if (At is "main")
                    {
                        <h1 class="dv-shell-title">@Shown.Name</h1>
                    }
                    else
                    {
                        <h2 class="dv-shell-title">@Shown.Name</h2>
                    }
                    @if (Shown.Status is "paused")
                    {
                        <Badge Kind="BadgeKind.Warn">Paused</Badge>
                    }
                    <BotNotifyMenu @key="Shown.Id" Bot="Shown" />
                    <nav class="dv-shell-beside" aria-label="Beside the conversation">
                        <a class="dv-shell-side dv-facet" href="@Addresses.Activity(Shown.Id)"
                           aria-current="@(Side is SideView.Activity ? "true" : null)">Activity</a>
                        <a class="dv-shell-side dv-facet" href="@Addresses.Summary(Shown.Id)"
                           aria-current="@(Side is SideView.Summary ? "true" : null)">Summary</a>
                        <a class="dv-shell-side dv-facet" href="@Addresses.Memory(Shown.Id)"
                           aria-current="@(Side is SideView.Memory ? "true" : null)">Memory</a>
                        @if (hasScreen || Side is SideView.Screen)
                        {
                            <a class="dv-shell-side dv-facet" href="@Addresses.Screen(Shown.Id)"
                               aria-current="@(Side is SideView.Screen ? "true" : null)">Screen</a>
                        }
                        <a class="dv-shell-side dv-facet" href="@Addresses.Files(Shown.Id)"
                           aria-current="@(Side is SideView.Files ? "true" : null)">Files</a>
                        <a class="dv-shell-side dv-facet" href="@Addresses.SideChats(Shown.Id)"
                           aria-current="@(Side is SideView.List or SideView.New or SideView.Chat ? "true" : null)">@SideChatsLabel</a>
                    </nav>
                </header>
                <ConversationPane @key="Shown.Id" Bot="Shown" Main="true" Opened="@(At is not "crew")" Moment="@(Side is SideView.Closed ? Moment : null)"
                                  OnThreadChanged="Remember" OnBusyChanged="MainBusyChanged"
                                  Crew="bots!" WorkAddress="WorkAddress" OnHandoffsChanged="MainHandoffsChanged" />
            }
        </main>
        @if (Side is not SideView.Closed && Shown is not null && NotReady is null)
        {
            <aside class="dv-shell-rail" aria-label="@RailName">
                <header class="dv-shell-rail-header">
                    @if (Side is SideView.List or SideView.Summary or SideView.Memory or SideView.Screen or SideView.Files or SideView.Work or SideView.Activity)
                    {
                        <a class="dv-shell-up" href="@Addresses.Talk(Shown.Id)" aria-label="@CloseRailName">
                            <Icon Name="IconName.Close" Size="20" />
                        </a>
                    }
                    else
                    {
                        <a class="dv-shell-up" href="@Addresses.SideChats(Shown.Id)" aria-label="All side chats with @Shown.Name">
                            <Icon Name="IconName.ArrowLeft" Size="20" />
                        </a>
                    }
                    <span class="dv-shell-bot dv-mono">@(Side is SideView.Work ? WorkName : Shown.Name)</span>
                    <h1 class="dv-shell-title">@SideTitle</h1>
                </header>
                @if (Side is SideView.Summary)
                {
                    <SummaryPanel @key="Shown.Id" Bot="Shown" Version="summaryVersion" />
                }
                else if (Side is SideView.Screen)
                {
                    <ScreenPanel @key="Shown.Id" Bot="Shown" />
                }
                else if (Side is SideView.Activity)
                {
                    <ActivityPanel @key="Shown.Id" Bot="Shown" Bots="bots!" RunId="ActivityRunId" Version="activityVersion" />
                }
                else if (Side is SideView.Memory)
                {
                    <MemoryRail @key="Shown.Id" Bot="Shown" Version="conversationVersion" />
                }
                else if (Side is SideView.Work)
                {
                    @if (WorkBot is null)
                    {
                        <div class="dv-shell-rail-body">
                            <EmptyState Title="This bot is not here" Cause="It was removed, so its side of this work cannot be shown."
                                        ActionLabel="@($"Back to {Shown.Name}")" ActionHref="@Addresses.Talk(Shown.Id)" />
                        </div>
                    }
                    else
                    {
                        <ConversationPane @key="WorkThreadId" Bot="WorkBot" ThreadId="WorkThreadId" ReadOnly="true" Crew="bots!" WorkAddress="WorkAddress" />
                    }
                }
                else if (Side is SideView.Files)
                {
                    <ExchangedFiles @key="Shown.Id" Bot="Shown" Version="conversationVersion" />
                }
                else if (Side is SideView.List)
                {
                    <div class="dv-shell-rail-body">
                        <p class="dv-shell-hint">A side chat is a separate conversation with @Shown.Name. What is said there stays out of the main conversation.</p>
                        @if (SideChats.Count > 0)
                        {
                            <SideChatList Chats="SideChats" />
                        }
                        <a class="dv-shell-new dv-facet" href="@Addresses.NewSideChat(Shown.Id)">
                            <Icon Name="IconName.Plus" />
                            New side chat
                        </a>
                    </div>
                }
                else
                {
                    <ConversationPane @key="sideKey" Bot="Shown" ThreadId="ThreadId" Moment="Moment" OnThreadStarted="SideChatStarted" OnThreadChanged="Remember" OnBusyChanged="SideBusyChanged"
                                      Crew="bots!" WorkAddress="WorkAddress" OnHandoffsChanged="SideHandoffsChanged" />
                }
            </aside>
        }
    </div>
</SessionGate>

@code {
    // What stands in for the workspace until there is a bot to talk to. A phone shows it in the list;
    // a wide window shows it in the main pane.
    private RenderFragment? NotReady => this switch
    {
        { spaceProblem: not null } =>
            @<EmptyState Title="Drover could not load this space" Cause="@spaceProblem" ActionLabel="Try again" OnAction="LoadSpace" />,
        { bots: null } =>
            @<p class="dv-shell-hint" role="status">Loading your space.</p>,
        { connections.Count: 0 } =>
            @<EmptyState Title="No model is connected" Cause="A bot needs a model to think with, and this space has none yet."
                         ActionLabel="Connect a model" ActionHref="@Addresses.SetupModel" />,
        { bots.Count: 0 } =>
            @<EmptyState Title="No bot yet" Cause="A model is connected, and there is no bot to use it."
                         ActionLabel="Meet your first bot" ActionHref="@Addresses.SetupBot" />,
        _ => null,
    };
}
