@inherits LayoutComponentBase

@* The bar names the person, so nothing of it is drawn until it is known who is signed in. *@
<SessionGate>
<div class="dv-work dv-yard">
    <header class="dv-work-header">
        <a class="dv-work-home" href="@Addresses.Home"><DroverMark />Drover</a>
        <nav class="dv-work-nav" aria-label="Drover">
            <NavLink class="dv-work-link" href="@Addresses.Home" Match="NavLinkMatch.All">Threads</NavLink>
            <NavLink class="dv-work-link" href="@Addresses.Bots">Bots</NavLink>
            <NavLink class="dv-work-link" href="@Addresses.Models">Models</NavLink>
            <NavLink class="dv-work-link" href="@Addresses.Tools">Tools</NavLink>
        </nav>
        <AccountMenu />
    </header>
    <main class="dv-work-main">
        @Body
    </main>
</div>
</SessionGate>
