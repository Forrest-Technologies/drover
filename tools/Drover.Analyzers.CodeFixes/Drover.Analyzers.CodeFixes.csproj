<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Directory.Build.props runs the analyzers over this project. The fixes also need their rule ids,
         so the same reference is switched to reference the output too. -->
    <ProjectReference Update="..\Drover.Analyzers\Drover.Analyzers.csproj" ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
